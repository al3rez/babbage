/* Minimal Raycast-style launcher (files/bin/launcher): search field + apps. Sizes are Raycast's
 * points at the desktop's 1.5x scale (144 DPI); picom blurs what's behind the window
 * (files/picom/picom.conf). */
configuration {
  dpi: 144;
  icon-theme: "WhiteSur-Mac";
  show-icons: true;
}

* {
  font: "Inter 10";
  primary: rgba(255, 255, 255, 0.92);
  hairline: rgba(255, 255, 255, 0.08);
  background-color: transparent;
  text-color: @primary;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  location: north;
  anchor: north;
  y-offset: 21%;
  width: 1124px;
  background-color: rgba(30, 30, 33, 0.70);
  border: 1px;
  border-color: rgba(255, 255, 255, 0.13);
  border-radius: 18px;
}

mainbox {
  children: [ inputbar, listview ];
}

inputbar {
  children: [ entry ];
  expand: false;
  padding: 25px 24px 25px 26px;
  border: 0 0 1px 0;
  border-color: @hairline;
}
entry {
  font: "Inter 12";
  vertical-align: 0.5;
  placeholder: "Search apps...";
  placeholder-color: rgba(255, 255, 255, 0.45);
  cursor-color: @primary;
  cursor-width: 2px;
}

listview {
  lines: 9;
  expand: true;
  fixed-height: true;
  scrollbar: false;
  cycle: false;
  padding: 8px 12px 12px 12px;
}

/* a row: icon, name */
element {
  children: [ element-icon, element-text ];
  padding: 16px 11px 16px 13px;
  spacing: 16px;
  border-radius: 10px;
}
element selected.normal {
  background-color: rgba(255, 255, 255, 0.10);
}
element-icon {
  size: 28px;
  vertical-align: 0.5;
}
element-text {
  vertical-align: 0.5;
  text-color: @primary;
  highlight: none;
}
