#!@python@
"""Put the LG (DP-2) + ASUS (DP-4) NVIDIA layout back if the driver ever changes it, and keep
each xfce4-panel bar on its own monitor.

RandR events trigger layout checks. A cheap X DPMS/idle check also detects user return
without a RandR event; all layout reads use cached state, never a driver probe.
Never applies a MetaMode while asleep, idle, or missing an expected output.

Bars: i3 docks a bar on whichever monitor the window is on when it maps, so after the panel
restarts the ASUS bar can land under the LG one. The bar's _NET_WM_STRUT_PARTIAL still says
which monitor the panel meant it for; one ConfigureRequest to that spot makes i3 move the dock
there. Checked on the same 5s tick (window tree only).

Every monitor that is on must have a menu bar that i3 docks. After the monitors drop off and
come back, xfce4-panel can keep running while i3 no longer manages its bar windows (unmapped, in
no dock area); the panel can also crash or hang. Any of those, lasting BARS_HIDDEN_FOR seconds
while the user is active, gets the panel restarted (killed if it won't quit). This runs even
while the other monitor is off. A bar i3 still docks but hides under a fullscreen window counts
as present and is left alone.
Logs and child-process errors go to the user service journal.
"""
import json
import os
import select
import signal
import subprocess
import syslog
import time

from Xlib import X, display
from Xlib.ext import dpms, randr

WANT = {"DP-2": (0, 0, 3840, 2160), "DP-4": (3840, 960, 1920, 1200)}
SETTLE = 3.0            # quiet seconds after the last RandR event before checking
IDLE_RECHECK = 5.0      # cached X DPMS/idle state only, not DisplayPort probing
ACTIVE_WITHIN_MS = 60_000
CMD_TIMEOUT = 30
RETRY_MIN, RETRY_MAX = 10.0, 300.0
APPLY = os.environ["APPLY_DESK_LAYOUT"]
BAR_HEIGHT = 36
BARS_HIDDEN_FOR = 8.0    # seconds a bar window has been outside i3's tree before restarting the panel
RESTART_COOLDOWN = 60.0  # at most one panel restart a minute

syslog.openlog("monitor-layout-guard", 0, syslog.LOG_USER)


def log(msg):
    syslog.syslog(syslog.LOG_NOTICE, msg)


def connected(d):
    root = d.screen().root
    res = randr.get_screen_resources_current(root)   # cached: never triggers a probe
    names = set()
    for o in res.outputs:
        info = randr.get_output_info(root, o, res.config_timestamp)
        if info.connection == randr.Connected:
            names.add(info.name)
    return names


def layout_ok(d):
    mons, primary = {}, None
    for m in randr.get_monitors(d.screen().root, True).monitors:
        name = d.get_atom_name(m.name)
        mons[name] = (m.x, m.y, m.width_in_pixels, m.height_in_pixels)
        if m.primary:
            primary = name
    return primary == "DP-2" and all(mons.get(n) == g for n, g in WANT.items())


def user_present(d):
    # an X server without the DPMS extension (another desktop's session) has no dpms_info:
    # judge by input idle time alone instead of failing every check
    if hasattr(d, "dpms_info"):
        info = d.dpms_info()
        if info.state and info.power_level != dpms.DPMSModeOn:
            return False
    return d.screen().root.screensaver_query_info().idle < ACTIVE_WITHIN_MS


def apply_layout():
    # Kill the entire shell/driver-client group on timeout, not just its shell.
    # stderr is inherited so NVIDIA failures remain visible in the journal.
    with subprocess.Popen([APPLY], start_new_session=True) as proc:
        try:
            code = proc.wait(timeout=CMD_TIMEOUT)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
            log(f"apply-desk-layout timed out after {CMD_TIMEOUT}s; killed process group")
            return False
    if code:
        log(f"apply-desk-layout exited with status {code}")
    return code == 0


def check(d):
    """Seconds until the next check, or None when nothing is pending."""
    if not user_present(d):
        return IDLE_RECHECK
    missing = WANT.keys() - connected(d)
    if missing:
        log(f"waiting for outputs: {', '.join(sorted(missing))}")
        return RETRY_MIN
    if layout_ok(d):
        return None
    log("layout differs from the expected one; re-applying")
    if not apply_layout():
        return RETRY_MIN
    return None if layout_ok(d) else RETRY_MIN


def panel_bars(d, shown_only=True):
    """36px xfce4-panel windows (shown ones unless shown_only=False): (window, x, y, strut or None)."""
    bars, strut_atom, root = [], d.intern_atom("_NET_WM_STRUT_PARTIAL"), d.screen().root
    def walk(w):
        try:
            cls = w.get_wm_class()
            if cls and cls[0] == "xfce4-panel":
                g = w.get_geometry()
                if g.height == BAR_HEIGHT and (not shown_only or w.get_attributes().map_state == X.IsViewable):
                    t = w.translate_coords(root, 0, 0)
                    p = w.get_full_property(strut_atom, X.AnyPropertyType)
                    bars.append((w, -t.x, -t.y, list(p.value) if p and len(p.value) == 12 else None))
            for c in w.query_tree().children:
                walk(c)
        except Exception:
            pass
    walk(root)
    return bars


def i3_windows():
    """X window ids i3 manages (docks included), or None if i3 can't be asked."""
    r = subprocess.run(["i3-msg", "-t", "get_tree"], capture_output=True, text=True, timeout=CMD_TIMEOUT)
    if r.returncode != 0:
        return None
    ids, stack = set(), [json.loads(r.stdout)]
    while stack:
        n = stack.pop()
        if n.get("window"):
            ids.add(n["window"])
        stack += n.get("nodes", []) + n.get("floating_nodes", [])
    return ids


def monitors_without_bar(d):
    """Names of monitors that are on, at their WANT geometry, with no bar docked by i3 (panel
    down, or bars dropped by i3). A docked bar hidden under a fullscreen window still counts."""
    managed = i3_windows()
    if managed is None:
        return []
    on = {d.get_atom_name(m.name): (m.x, m.y, m.width_in_pixels, m.height_in_pixels)
          for m in randr.get_monitors(d.screen().root, True).monitors}
    docked = {meant_for(strut) for w, _, _, strut in panel_bars(d, shown_only=False) if w.id in managed}
    return sorted(n for n, g in WANT.items() if on.get(n) == g and g[:2] not in docked)


def meant_for(strut):
    """(x, y) of the monitor whose top edge the bar's strut reserves space below."""
    if not strut:
        return None
    top, mid = strut[2], (strut[8] + strut[9]) // 2
    hits = [(mx, my) for mx, my, mw, _ in WANT.values() if my + BAR_HEIGHT == top and mx <= mid < mx + mw]
    return hits[0] if len(hits) == 1 else None


def reseat_bars(d):
    for w, x, y, strut in panel_bars(d):
        target = meant_for(strut)
        if target and (x, y) != target:
            log(f"menu bar at {x},{y} belongs at {target[0]},{target[1]}; moving it back")
            w.configure(x=target[0], y=target[1])
    d.sync()


def panel_running():
    return subprocess.run(["pgrep", "-x", "xfce4-panel"], stdout=subprocess.DEVNULL).returncode == 0


def restart_panel():
    """Quit (or kill) xfce4-panel and start it fresh. After the monitors drop off and come back,
    only a fresh start maps the bars again (never `-r`, which can leave a bar unmapped on this
    layout). Started through i3 so it docks like at login."""
    log("restarting xfce4-panel")
    if panel_running():
        subprocess.run(["xfce4-panel", "-q"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
        for _ in range(50):
            if not panel_running():
                break
            time.sleep(0.1)
        else:
            log("xfce4-panel did not quit; killing it")
            subprocess.run(["pkill", "-KILL", "-x", "xfce4-panel"])
            time.sleep(0.5)
    subprocess.run(["i3-msg", "-q", "exec --no-startup-id /usr/bin/xfce4-panel"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)


def main():
    d = display.Display()
    root = d.screen().root
    randr.select_input(root, randr.RRScreenChangeNotifyMask | randr.RROutputChangeNotifyMask
                       | randr.RRCrtcChangeNotifyMask)
    d.flush()
    fd = d.fileno()
    due = time.monotonic() + SETTLE      # one check after login
    retry = RETRY_MIN
    present = False
    hidden_since = None                  # when a bar window was first seen outside i3's tree
    last_restart = 0.0
    while True:
        timeout = IDLE_RECHECK if due is None else min(IDLE_RECHECK, max(due - time.monotonic(), 0.0))
        # Xlib can already have queued events after a synchronous query.
        r = d.pending_events()
        if not r:
            r, _, _ = select.select([fd], [], [], timeout)
        now = time.monotonic()
        if r:
            while d.pending_events():
                d.next_event()
            due = now + SETTLE
            retry = RETRY_MIN
        try:
            active = user_present(d)
            if active and not present:
                log("user active; checking layout after wake/idle")
                due = now + SETTLE
                retry = RETRY_MIN
            present = active
            if due is None and layout_ok(d):
                reseat_bars(d)            # window tree only; safe on every tick
            # Not gated on the layout: the LG must get its bar back even while the ASUS stays off.
            bare = monitors_without_bar(d) if active else []
            if bare:
                hidden_since = hidden_since or now
                if now - hidden_since >= BARS_HIDDEN_FOR and now - last_restart >= RESTART_COOLDOWN:
                    log(f"no menu bar on {', '.join(bare)} for {int(now - hidden_since)}s")
                    restart_panel()
                    last_restart, hidden_since = now, None
            else:
                hidden_since = None
            if due is None or now < due:
                continue
            wait = check(d)
        except Exception as e:
            log(f"check failed ({e!r})")
            wait = retry
        if wait is None:
            due, retry = None, RETRY_MIN
        else:
            if wait == RETRY_MIN:
                wait, retry = retry, min(retry * 2, RETRY_MAX)
                log(f"layout pending; retrying in {int(wait)}s")
            due = time.monotonic() + wait


if __name__ == "__main__":
    main()
