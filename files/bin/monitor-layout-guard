#!@python@
"""Keep the LG (DP-2) + ASUS (DP-4) NVIDIA layout and both menu bars in place.

The NVIDIA driver forgets the custom MetaMode (ASUS drawn at 2880x1800, offset +3840+360,
LG primary) whenever the monitors sleep/wake or are replugged. This listens for RandR
screen-change events, waits for the outputs to settle, and puts the layout back; then it
checks that each xfce4-panel bar sits on its own monitor and restarts the panel if not.
Only the two-monitor case is managed; with either screen unplugged it does nothing.

It must never stall the X server, which owns the keyboard and mouse:
  * only the driver's cached output state is read (RRGetScreenResourcesCurrent); the
    non-cached request makes the NVIDIA driver re-probe every DisplayPort, blocking X
    for seconds each time
  * nothing happens while the monitors are off or nobody is at the keyboard: a MetaMode
    sent to sleeping DisplayPort monitors hangs X for ~45s and fails, and retrying that
    is what kept the screens black and input dead after the idle timeout. The layout is
    put back a few seconds after the user returns
  * no polling; failed attempts back off (30s doubling to 15min); driver calls time out
"""
import os
import select
import subprocess
import syslog
import time

from Xlib import display
from Xlib.ext import dpms, randr

METAMODE = (
    "DP-2: 3840x2160_240 +0+0 {ForceCompositionPipeline=On}, "
    "DP-4: 1920x1200_60 +3840+360 {ViewPortIn=2880x1800, ViewPortOut=1920x1200+0+0, "
    "ForceCompositionPipeline=On}"
)
WANT = {"DP-2": (0, 0, 3840, 2160), "DP-4": (3840, 360, 2880, 1800)}
BAR_HEIGHT = 36
WALLPAPER = os.environ.get("WALLPAPER", os.path.expanduser("~/Pictures/Wallpapers/wallhaven-gp7mq3.jpg"))
SETTLE = 3.0          # seconds of quiet after the last RandR event (or wake-up) before acting
DPMS_POLL = 5.0       # while waiting for the user to come back, look this often
ACTIVE_WITHIN_MS = 60_000   # only touch the layout if there was input in the last minute
CMD_TIMEOUT = 15      # seconds; a driver call that takes longer is abandoned
BACKOFF_MIN, BACKOFF_MAX = 30.0, 900.0


syslog.openlog("monitor-layout-guard", 0, syslog.LOG_USER)


def log(msg):
    syslog.syslog(syslog.LOG_NOTICE, msg)


def run(*cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=CMD_TIMEOUT)
    except subprocess.TimeoutExpired:
        log(f"timed out after {CMD_TIMEOUT}s: {cmd[0]}")


def user_present(d):
    """Monitors on and someone used the keyboard/mouse recently. Checked twice over because
    the NVIDIA driver does not always report DPMS-off; the idle timer is what dims the
    screens, so recent input reliably means they are awake."""
    info = d.dpms_info()
    if info.state and info.power_level != dpms.DPMSModeOn:
        return False
    return d.screen().root.screensaver_query_info().idle < ACTIVE_WITHIN_MS


def monitors(d):
    """Active monitors as {name: (x, y, w, h)} and the primary's name."""
    res = randr.get_monitors(d.screen().root, True)
    out, primary = {}, None
    for m in res.monitors:
        name = d.get_atom_name(m.name)
        out[name] = (m.x, m.y, m.width_in_pixels, m.height_in_pixels)
        if m.primary:
            primary = name
    return out, primary


def connected(d):
    root = d.screen().root
    res = randr.get_screen_resources_current(root)   # cached: never triggers a probe
    names = set()
    for o in res.outputs:
        info = randr.get_output_info(root, o, res.config_timestamp)
        if info.connection == randr.Connected:
            names.add(info.name)
    return names


def panel_bars(d):
    """Geometry of every menu-bar window (36px tall xfce4-panel)."""
    bars = []
    def walk(w):
        try:
            cls = w.get_wm_class()
            if cls and cls[0] == "xfce4-panel":
                g = w.get_geometry()
                if g.height == BAR_HEIGHT:
                    t = w.translate_coords(d.screen().root, 0, 0)
                    bars.append((-t.x, -t.y, g.width))
            for c in w.query_tree().children:
                walk(c)
        except Exception:
            pass
    walk(d.screen().root)
    return bars


def layout_ok(d):
    mons, primary = monitors(d)
    return primary == "DP-2" and all(mons.get(n) == g for n, g in WANT.items())


def bars_ok(d):
    bars = panel_bars(d)
    want = sorted((x, y, w) for x, y, w, _ in WANT.values())
    return sorted(bars) == want


def fix(d):
    """Returns True when everything is in place (or there is nothing to manage)."""
    if not WANT.keys() <= connected(d):
        return True
    if not layout_ok(d):
        log("layout differs from the expected one; re-applying MetaMode")
        run("nvidia-settings", "--assign", f"CurrentMetaMode={METAMODE}")
        run("xrandr", "--output", "DP-2", "--primary")
        if os.path.exists(WALLPAPER):
            run("feh", "--no-fehbg", "--bg-fill", WALLPAPER)
        time.sleep(1.0)   # let the panel and i3 see the new outputs
        if not layout_ok(d):
            log("re-apply did not take")
            return False
    if not bars_ok(d):
        time.sleep(1.5)   # the panel moves its bars itself on most changes; give it a moment
        if not bars_ok(d) and subprocess.run(["pgrep", "-x", "xfce4-panel"], stdout=subprocess.DEVNULL).returncode == 0:
            log("menu bars not on their monitors; restarting the panel")
            run("xfce4-panel", "-r")
    return True


def main():
    d = display.Display()
    root = d.screen().root
    randr.select_input(root, randr.RRScreenChangeNotifyMask | randr.RROutputChangeNotifyMask
                       | randr.RRCrtcChangeNotifyMask)
    d.flush()
    fd = d.fileno()
    pending_since = time.monotonic()   # check once at start
    backoff, not_before = BACKOFF_MIN, 0.0
    while True:
        if pending_since is None:
            timeout = None
        else:
            timeout = max(SETTLE - (time.monotonic() - pending_since), not_before - time.monotonic(), 0.1)
        r, _, _ = select.select([fd], [], [], timeout)
        if r:
            while d.pending_events():
                d.next_event()   # only RandR events are selected; any of them means "re-check"
                pending_since = time.monotonic()
            continue
        now = time.monotonic()
        if pending_since is None or now - pending_since < SETTLE or now < not_before:
            continue
        try:
            if not user_present(d):
                # monitors asleep / nobody here: leave the driver alone, look again shortly
                pending_since = now - SETTLE + DPMS_POLL
                continue
            if fix(d):
                backoff, not_before = BACKOFF_MIN, 0.0
            else:
                log(f"backing off {int(backoff)}s")
                not_before = now + backoff
                backoff = min(backoff * 2, BACKOFF_MAX)
                continue      # keep pending_since: retry once the backoff expires
        except Exception as e:
            log(f"check failed ({e!r}); backing off {int(backoff)}s")
            not_before = now + backoff
            backoff = min(backoff * 2, BACKOFF_MAX)
            continue
        pending_since = None


if __name__ == "__main__":
    main()
