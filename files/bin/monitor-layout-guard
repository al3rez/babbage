#!@python@
"""Put the LG (DP-2) + ASUS (DP-4) NVIDIA layout back if the driver ever changes it.

Event-driven only: it wakes on RandR events and reads the X server's cached state. When the
layout is right it does nothing at all. It never touches the panel or the bars, never polls
the driver, and never re-applies a layout while the monitors are asleep or nobody is at the
keyboard (a MetaMode sent to sleeping DisplayPort monitors hangs X for ~45s).
Logs to `journalctl -t monitor-layout-guard`.
"""
import os
import select
import subprocess
import syslog
import time

from Xlib import display
from Xlib.ext import dpms, randr

WANT = {"DP-2": (0, 0, 3840, 2160), "DP-4": (3840, 960, 1920, 1200)}
SETTLE = 3.0            # quiet seconds after the last RandR event before checking
IDLE_RECHECK = 5.0      # while monitors sleep / user away, look again this often
ACTIVE_WITHIN_MS = 60_000
CMD_TIMEOUT = 30
RETRY_MIN, RETRY_MAX = 10.0, 300.0
APPLY = os.environ["APPLY_DESK_LAYOUT"]

syslog.openlog("monitor-layout-guard", 0, syslog.LOG_USER)


def log(msg):
    syslog.syslog(syslog.LOG_NOTICE, msg)


def connected(d):
    root = d.screen().root
    res = randr.get_screen_resources_current(root)   # cached: never triggers a probe
    names = set()
    for o in res.outputs:
        info = randr.get_output_info(root, o, res.config_timestamp)
        if info.connection == randr.Connected:
            names.add(info.name)
    return names


def layout_ok(d):
    mons, primary = {}, None
    for m in randr.get_monitors(d.screen().root, True).monitors:
        name = d.get_atom_name(m.name)
        mons[name] = (m.x, m.y, m.width_in_pixels, m.height_in_pixels)
        if m.primary:
            primary = name
    return primary == "DP-2" and all(mons.get(n) == g for n, g in WANT.items())


def user_present(d):
    info = d.dpms_info()
    if info.state and info.power_level != dpms.DPMSModeOn:
        return False
    return d.screen().root.screensaver_query_info().idle < ACTIVE_WITHIN_MS


def check(d):
    """Seconds until the next check, or None when nothing is pending."""
    if not WANT.keys() <= connected(d) or layout_ok(d):
        return None
    if not user_present(d):
        return IDLE_RECHECK
    log("layout differs from the expected one; re-applying")
    try:
        subprocess.run([APPLY], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=CMD_TIMEOUT)
    except subprocess.TimeoutExpired:
        log(f"apply-desk-layout timed out after {CMD_TIMEOUT}s")
    return None if layout_ok(d) else RETRY_MIN


def main():
    d = display.Display()
    root = d.screen().root
    randr.select_input(root, randr.RRScreenChangeNotifyMask | randr.RROutputChangeNotifyMask
                       | randr.RRCrtcChangeNotifyMask)
    d.flush()
    fd = d.fileno()
    due = time.monotonic() + SETTLE      # one check after login
    retry = RETRY_MIN
    while True:
        timeout = None if due is None else max(due - time.monotonic(), 0.0)
        r, _, _ = select.select([fd], [], [], timeout)
        if r:
            while d.pending_events():
                d.next_event()
            due = time.monotonic() + SETTLE
            retry = RETRY_MIN
            continue
        try:
            wait = check(d)
        except Exception as e:
            log(f"check failed ({e!r})")
            wait = retry
        if wait is None:
            due, retry = None, RETRY_MIN
        else:
            if wait == RETRY_MIN:
                wait, retry = retry, min(retry * 2, RETRY_MAX)
                log(f"layout still wrong; retrying in {int(wait)}s")
            due = time.monotonic() + wait


if __name__ == "__main__":
    main()
