#!@python@
"""Minimal Raycast-style app launcher on rofi (dmenu mode).

One flat list of the desktop's applications: the ones launched most from here first, then
the rest A-Z. Typing searches all of them (fuzzy, best match first). Enter opens the app,
Esc closes. The look lives in the rofi theme (files/rofi/launcher.rasi).
"""
import configparser
import json
import os
import subprocess
import sys

ROFI = "@rofi@"
THEME = "@theme@"
GTK_LAUNCH = "@gtklaunch@"

HISTORY = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                       "launcher", "history.json")
DESKTOP = set(filter(None, os.environ.get("XDG_CURRENT_DESKTOP", "XFCE").split(":")))


def data_dirs():
    yield os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    yield from (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")


def applications():
    """{desktop id: entry} for every app a menu would show; earlier data dirs win."""
    seen, apps = set(), {}
    for base in data_dirs():
        root = os.path.join(base, "applications")
        for dirpath, _, files in os.walk(root):
            for f in sorted(files):
                if not f.endswith(".desktop"):
                    continue
                path = os.path.join(dirpath, f)
                app_id = os.path.relpath(path, root)[:-len(".desktop")].replace("/", "-")
                if app_id in seen:
                    continue
                seen.add(app_id)
                entry = read_entry(path)
                if entry:
                    apps[app_id] = entry
    return apps


def read_entry(path):
    cp = configparser.RawConfigParser(strict=False)
    cp.optionxform = str
    try:
        cp.read(path, encoding="utf-8")
        e = cp["Desktop Entry"]
    except (configparser.Error, KeyError, UnicodeDecodeError):
        return None
    listed = lambda k: set(filter(None, e.get(k, "").split(";")))
    if (e.get("Type") != "Application" or e.get("NoDisplay") == "true" or e.get("Hidden") == "true"
            or not e.get("Name") or (listed("OnlyShowIn") and not listed("OnlyShowIn") & DESKTOP)
            or listed("NotShowIn") & DESKTOP):
        return None
    exe = os.path.basename(e.get("Exec", "").split(" ")[0])
    return {"name": e["Name"], "icon": e.get("Icon", "application-x-executable"),
            "meta": " ".join([e.get("GenericName", ""), e.get("Keywords", "").replace(";", " "), exe])}


def load_history():
    try:
        with open(HISTORY) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_history(history):
    os.makedirs(os.path.dirname(HISTORY), exist_ok=True)
    tmp = HISTORY + ".tmp"
    with open(tmp, "w") as f:
        json.dump(history, f)
    os.replace(tmp, HISTORY)


def clean(s):
    return s.replace("\0", "").replace("\n", " ").replace("\x1f", " ")


def main():
    apps = applications()
    history = load_history()
    ids = sorted(apps, key=lambda a: (-history.get(a, 0), apps[a]["name"].lower()))
    rows = [f"{clean(apps[a]['name'])}\0icon\x1f{clean(apps[a]['icon'])}\x1fmeta\x1f{clean(apps[a]['meta'])}"
            for a in ids]

    proc = subprocess.run(
        [ROFI, "-dmenu", "-theme", THEME, "-p", "", "-i", "-show-icons", "-no-custom",
         "-format", "i", "-matching", "fuzzy", "-sort", "-sorting-method", "fzf"],
        input="\n".join(rows), capture_output=True, text=True,
        # Nix's rofi can't load Debian's locales (it quits silently); C.UTF-8 is built in
        env={**os.environ, "LC_ALL": "C.UTF-8"})
    index = proc.stdout.strip()
    if proc.returncode != 0 or not index.isdigit():
        return
    app = ids[int(index)]
    subprocess.Popen([GTK_LAUNCH, app], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    history[app] = history.get(app, 0) + 1
    save_history(history)


if __name__ == "__main__":
    sys.exit(main())
