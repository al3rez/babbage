"""Tailscale in the menu bar, the way macOS menu-bar apps do it.

`tailscale systray` paints its own full-colour bitmap, which can't be themed to match the
white glyphs. This is a StatusNotifierItem of its own instead: a themed white dot mark in the
tray (files/icons/tailscale, faint when disconnected), and clicking it opens a popover panel
under the bar, laid out like a macOS menu-bar popover:

  [logo] Tailscale                     (switch)    connect / disconnect
  <this device> · <ip>                             click copies the IP
  Network Devices
    [icon] <device>                  100.x.y.z     click copies the IP ("Copied")
    Offline (n)                                    expands the offline ones
  Exit Node                                        only when a device offers one
    ✓ None / <device>
  Admin Console

picom rounds it, makes it slightly translucent and frosts it (files/picom/picom.conf, class
Tailscale-tray), the same as the tray menus. Escape or a click
outside closes it. Runs under modules/panel.nix's wrapper (Nix GTK + typelibs).
"""
import json
import os
import socket
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk  # noqa: E402

TAILSCALE = os.environ.get("TAILSCALE", "tailscale")
ICONS = os.environ["TAILSCALE_TRAY_ICONS"]
XCLIP = os.environ.get("XCLIP", "xclip")
ADMIN = "https://login.tailscale.com/admin/machines"
POLL = 5          # seconds between status checks
BAR = 36          # menu bar height (px)
WIDTH_PT = 340    # popover width in points (macOS popovers are ~300-340pt)

SNI_XML = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconThemePath" type="s" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <method name="Activate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="SecondaryActivate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="ContextMenu"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="Scroll"><arg name="delta" type="i" direction="in"/><arg name="orientation" type="s" direction="in"/></method>
    <signal name="NewIcon"/>
    <signal name="NewToolTip"/>
  </interface>
</node>"""


def status():
    try:
        out = subprocess.run([TAILSCALE, "status", "--json"], capture_output=True, text=True, timeout=3).stdout
        return json.loads(out)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None


def ipv4(node):
    return next((ip for ip in node.get("TailscaleIPs") or [] if "." in ip), "")


def copy(text):
    p = subprocess.Popen([XCLIP, "-selection", "clipboard"], stdin=subprocess.PIPE,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    p.communicate(text.encode())


def run(*cmd, then=None):
    """Run a tailscale command without blocking the UI; `then` runs when it exits."""
    proc = Gio.Subprocess.new(list(cmd), Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
    if then:
        proc.wait_async(None, lambda *_: then())


def device_icon(os_name):
    return "device-phone.svg" if os_name in ("iOS", "android") else "device-laptop.svg"


def image(name, size):
    """One of files/icons/tailscale at `size` px, drawn at that size (crisp at 1.5x)."""
    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(os.path.join(ICONS, name), size, size)
    return Gtk.Image.new_from_pixbuf(pb)


def css(scale):
    px = lambda v: f"{round(v * scale)}px"
    return f"""
    window.tailscale-popover {{ background-color: #f6f6f8; }}
    .card {{ background-color: #f6f6f8; border-radius: {px(12)};
             border: 1px solid rgba(0, 0, 0, 0.10); padding: {px(8)}; }}
    .card, .card label {{ color: rgba(0, 0, 0, 0.85); font-family: "Inter"; }}
    .title {{ font-weight: 600; }}
    .dim, .card label.dim {{ color: rgba(0, 0, 0, 0.45); }}
    .section {{ color: rgba(0, 0, 0, 0.50); font-weight: 600; margin: {px(10)} {px(8)} {px(4)} {px(8)}; }}
    .row {{ padding: {px(7)} {px(8)}; border-radius: {px(7)}; }}
    .row:hover {{ background-color: rgba(0, 0, 0, 0.055); }}
    .row image {{ color: rgba(0, 0, 0, 0.55); }}
    .offline label {{ color: rgba(0, 0, 0, 0.40); }}
    .rule {{ background-color: rgba(0, 0, 0, 0.08); min-height: 1px; margin: {px(6)} {px(8)}; }}
    .header {{ padding: {px(6)} {px(8)} {px(2)} {px(8)}; }}
    .check {{ color: #0a84ff; font-weight: 600; }}
    switch {{ min-width: {px(36)}; min-height: {px(20)}; border-radius: {px(11)}; border: none;
              background-color: rgba(0, 0, 0, 0.12); background-image: none; box-shadow: none; }}
    switch:checked {{ background-color: #34c759; }}
    switch slider {{ min-width: {px(18)}; min-height: {px(18)}; border-radius: {px(10)}; margin: {px(1)};
                     background-color: #ffffff; background-image: none; border: none;
                     box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25); }}
    switch image {{ color: transparent; }}
    """


class Popover(Gtk.Window):
    def __init__(self, app):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)   # not "normal": picom would dim it
        self.set_wmclass("tailscale-tray", "Tailscale-tray")   # picom's rule matches this
        self.app = app
        # an opaque window: picom rounds it, makes it slightly translucent and blurs what's
        # behind (a 32-bit window drawn by GTK here shows up fully transparent under picom)
        self.get_style_context().add_class("tailscale-popover")
        self.connect("button-press-event", self.on_button)
        self.connect("key-press-event", lambda _w, e: e.keyval == Gdk.KEY_Escape and self.close_popover())
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.KEY_PRESS_MASK)
        self.show_offline = False
        self.card = None

    def on_button(self, _w, e):
        alloc = self.get_allocation()
        if not (0 <= e.x <= alloc.width and 0 <= e.y <= alloc.height):
            self.close_popover()
        return False

    def open_at(self, px, py):
        self.build(self.app.state)
        display = Gdk.Display.get_default()
        mon = display.get_monitor_at_point(px, py).get_geometry()
        self.resize(1, 1)   # shrink-wrap to the content every time
        self.show_all()
        w, _h = self.get_size()
        x = min(max(px - w // 2, mon.x + 12), mon.x + mon.width - w - 12)
        self.move(x, mon.y + BAR + 6)
        self.present()
        GLib.idle_add(self.grab)

    def grab(self):
        seat = Gdk.Display.get_default().get_default_seat()
        seat.grab(self.get_window(), Gdk.SeatCapabilities.ALL, True, None, None, None)
        return False

    def close_popover(self):
        Gdk.Display.get_default().get_default_seat().ungrab()
        self.hide()
        return True

    # ---- content -----------------------------------------------------------------------
    def label(self, text, *classes, xalign=0.0, expand=False):
        lab = Gtk.Label(label=text, xalign=xalign)
        lab.set_hexpand(expand)
        lab.set_ellipsize(3 if expand else 0)   # PANGO_ELLIPSIZE_END
        for c in classes:
            lab.get_style_context().add_class(c)
        return lab

    def row(self, box, icon, name, detail, on_click, *classes):
        ev = Gtk.EventBox()
        ev.set_visible_window(False)
        inner = Gtk.Box(spacing=round(10 * self.app.scale))
        inner.get_style_context().add_class("row")
        for c in classes:
            inner.get_style_context().add_class(c)
        if icon:
            inner.pack_start(image(icon, round(18 * self.app.scale)), False, False, 0)
        inner.pack_start(self.label(name, expand=True), True, True, 0)
        detail_label = self.label(detail, "dim", xalign=1.0)
        inner.pack_end(detail_label, False, False, 0)
        ev.add(inner)
        if on_click:
            ev.connect("button-release-event", lambda *_: on_click(detail_label) or True)
            ev.connect("enter-notify-event", lambda *_: inner.set_state_flags(Gtk.StateFlags.PRELIGHT, False))
            ev.connect("leave-notify-event", lambda *_: inner.unset_state_flags(Gtk.StateFlags.PRELIGHT))
        box.pack_start(ev, False, False, 0)

    def copier(self, ip):
        def click(detail_label):
            copy(ip)
            detail_label.set_text("Copied")
            GLib.timeout_add(1200, lambda: detail_label.set_text(ip) and False)
        return click

    def rule(self, box):
        sep = Gtk.Box()
        sep.get_style_context().add_class("rule")
        box.pack_start(sep, False, False, 0)

    def build(self, s):
        if self.card:
            self.remove(self.card)
        sc = self.app.scale
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.get_style_context().add_class("card")
        card.set_size_request(round(WIDTH_PT * sc), -1)
        self.card = card
        self.add(card)

        state = (s or {}).get("BackendState")
        running = state == "Running"
        me = (s or {}).get("Self") or {}

        # header: logo, name, switch; this device underneath
        head = Gtk.Box(spacing=round(10 * sc))
        head.get_style_context().add_class("header")
        head.pack_start(image("tailscale-logo.svg", round(18 * sc)), False, False, 0)
        head.pack_start(self.label("Tailscale", "title", expand=True), True, True, 0)
        sw = Gtk.Switch(active=running, valign=Gtk.Align.CENTER)
        sw.set_sensitive(bool(s) and state in ("Running", "Stopped"))
        sw.connect("notify::active", lambda w, _p: run(TAILSCALE, "up" if w.get_active() else "down",
                                                       then=self.app.refresh_now))
        head.pack_end(sw, False, False, 0)
        card.pack_start(head, False, False, 0)
        if running:
            self.row(card, None, me.get("HostName", ""), ipv4(me), self.copier(ipv4(me)))
        else:
            text = {"Stopped": "Disconnected", "NeedsLogin": "Logged out — run tailscale up",
                    None: "tailscaled is not running"}.get(state, state)
            self.row(card, None, text, "", None, "offline")

        if running:
            peers = sorted((s.get("Peer") or {}).values(), key=lambda p: (p.get("HostName") or "").lower())
            online = [p for p in peers if p.get("Online")]
            offline = [p for p in peers if not p.get("Online")]
            self.rule(card)
            card.pack_start(self.label("Network Devices", "section"), False, False, 0)
            listing = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            for p in online:
                self.row(listing, device_icon(p.get("OS")), p.get("HostName", ""), ipv4(p), self.copier(ipv4(p)))
            if offline:
                arrow = "▾" if self.show_offline else "▸"
                self.row(listing, None, f"Offline ({len(offline)})", arrow, lambda _l: self.toggle_offline(), "offline")
                if self.show_offline:
                    for p in offline:
                        self.row(listing, device_icon(p.get("OS")), p.get("HostName", ""), ipv4(p),
                                 self.copier(ipv4(p)), "offline")
            card.pack_start(listing, False, False, 0)

            exits = [p for p in peers if p.get("ExitNodeOption")]
            if exits:
                self.rule(card)
                card.pack_start(self.label("Exit Node", "section"), False, False, 0)
                current = next((p for p in exits if p.get("ExitNode")), None)
                self.row(card, None, "None", "✓" if not current else "",
                         lambda _l: run(TAILSCALE, "set", "--exit-node=", then=self.app.refresh_now))
                for p in exits:
                    ip = ipv4(p)
                    self.row(card, device_icon(p.get("OS")), p.get("HostName", ""), "✓" if p is current else "",
                             lambda _l, ip=ip: run(TAILSCALE, "set", f"--exit-node={ip}", then=self.app.refresh_now),
                             *(() if p.get("Online") else ("offline",)))

        self.rule(card)
        self.row(card, None, "Admin Console", "↗", lambda _l: (subprocess.Popen(
            ["xdg-open", ADMIN], start_new_session=True), self.close_popover()))
        card.show_all()

    def toggle_offline(self):
        self.show_offline = not self.show_offline
        self.build(self.app.state)
        self.resize(1, 1)


class App:
    def __init__(self):
        GLib.set_prgname("tailscale-tray")   # WM_CLASS Tailscale-tray, for picom's rule
        dpi = Gtk.Settings.get_default().get_property("gtk-xft-dpi")
        self.scale = (dpi / 1024 / 96) if dpi and dpi > 0 else 1.0
        provider = Gtk.CssProvider()
        provider.load_from_data(css(self.scale).encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        self.state = status()
        self.icon = self.icon_name()
        self.popover = Popover(self)
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.node = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
        self.bus.register_object("/StatusNotifierItem", self.node.interfaces[0],
                                 self.on_call, self.on_get, None)
        self.name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
        Gio.bus_own_name_on_connection(self.bus, self.name, Gio.BusNameOwnerFlags.NONE, None, None)
        # (re)register whenever a tray appears, e.g. after the panel restarts
        Gio.bus_watch_name_on_connection(self.bus, "org.kde.StatusNotifierWatcher",
                                         Gio.BusNameWatcherFlags.NONE, self.register, None)
        GLib.timeout_add_seconds(POLL, self.poll)

    def icon_name(self):
        return "tailscale-connected" if (self.state or {}).get("BackendState") == "Running" else "tailscale-disconnected"

    def tooltip(self):
        s = self.state or {}
        if s.get("BackendState") == "Running":
            me = s.get("Self") or {}
            return f"Tailscale: Connected — {me.get('HostName', '')} {ipv4(me)}"
        return "Tailscale: " + {"Stopped": "Disconnected", "NeedsLogin": "Logged out"}.get(
            s.get("BackendState"), "Not running")

    def register(self, *_):
        self.bus.call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                      "org.kde.StatusNotifierWatcher", "RegisterStatusNotifierItem",
                      GLib.Variant("(s)", (self.name,)), None, Gio.DBusCallFlags.NONE, -1, None, None)

    def on_get(self, _conn, _sender, _path, _iface, prop):
        values = {
            "Category": GLib.Variant("s", "ApplicationStatus"),
            "Id": GLib.Variant("s", "tailscale"),
            "Title": GLib.Variant("s", "Tailscale"),
            "Status": GLib.Variant("s", "Active"),
            "IconName": GLib.Variant("s", self.icon),
            "IconThemePath": GLib.Variant("s", ICONS),
            "ItemIsMenu": GLib.Variant("b", False),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", ("", [], "Tailscale", self.tooltip())),
        }
        return values.get(prop)

    def on_call(self, _conn, _sender, _path, _iface, method, params, invocation):
        if method in ("Activate", "SecondaryActivate", "ContextMenu"):
            if self.popover.get_visible():
                self.popover.close_popover()
            else:
                _screen, px, py = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()
                self.popover.open_at(px, py)
        invocation.return_value(None)

    def emit(self, signal):
        self.bus.emit_signal(None, "/StatusNotifierItem", "org.kde.StatusNotifierItem", signal, None)

    def refresh_now(self):
        self.poll()
        return False

    def poll(self):
        self.state = status()
        icon = self.icon_name()
        if icon != self.icon:
            self.icon = icon
            self.emit("NewIcon")
        self.emit("NewToolTip")
        if self.popover.get_visible():
            self.popover.build(self.state)
            self.popover.resize(1, 1)
        return True


def main():
    # one tray icon per session: a second start just exits
    lock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        lock.bind(f"\0tailscale-tray-{os.getuid()}")
    except OSError:
        return 0
    App()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
