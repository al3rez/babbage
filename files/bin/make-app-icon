#!/usr/bin/env python3
"""Fit an app's artwork into Grok Bot's macOS (Big Sur) squircle so pinned icons match.

usage: make-app-icon <artwork.png> <name> <hicolor-dir> [--square]
  default: artwork is already an icon; its opaque area is fitted to the squircle box
  --square: artwork is full-bleed (no rounded corners of its own); fill the whole box
Writes <hicolor-dir>/<size>x<size>/apps/<name>.png for the usual sizes.
"""
import os, sys
from PIL import Image, ImageChops

HERE = os.path.dirname(os.path.abspath(__file__))
MASK = os.path.join(HERE, "..", "icons", "hicolor", "512x512", "apps", "grok-bot.png")
SIZES = (16, 24, 32, 48, 64, 128, 256, 512)


def fit(art_path, square):
    ref = Image.open(MASK).convert("RGBA")
    mask = ref.split()[3]                           # the squircle, at Grok's exact margins
    box = mask.point(lambda v: 255 if v > 20 else 0).getbbox()
    art = Image.open(art_path).convert("RGBA")
    if not square:
        art = art.crop(art.split()[3].point(lambda v: 255 if v > 20 else 0).getbbox())
    w, h = box[2] - box[0], box[3] - box[1]
    out = Image.new("RGBA", ref.size)
    out.paste(art.resize((w, h), Image.LANCZOS), box[:2])
    out.putalpha(ImageChops.multiply(out.split()[3], mask))
    return out


def main():
    art, name, root = sys.argv[1:4]
    icon = fit(art, "--square" in sys.argv)
    for s in SIZES:
        d = os.path.join(root, f"{s}x{s}", "apps")
        os.makedirs(d, exist_ok=True)
        icon.resize((s, s), Image.LANCZOS).save(os.path.join(d, f"{name}.png"), optimize=True)


if __name__ == "__main__":
    main()
