#!/usr/bin/env python3
"""Bar icon sizes: the width and height of each pinned app's icon and each tray glyph on the
menu bar, changed live and saved to the Babbage repo.

  bar-icons          a window with one row per icon: width and height in px (linked to keep
                     the proportions, or not) and Reset. The bar changes as you go; Save writes
                     the sizes to the repo (files/panel/icon-sizes.json), Revert goes back to
                     the saved ones.
  bar-icons apply    draws the saved sizes on the bar; Home Manager runs it after every switch.

A size is the icon's visible size inside the bar's icon slot (xfce4-panel icon-size, 30px), so
at most the slot. Icons without one keep their artwork's own size. A pinned app gets a PNG
drawn at exactly that size, and its launcher's Icon= points at it (the launcher plugin
notices the file change). A tray glyph (files/icons/tailscale) gets a scaled copy of its SVG in
the state directory, which files/bin/menubar-popovers watches and shows instead.
"""
import configparser
import glob
import hashlib
import json
import os
import re
import subprocess
import sys

import gi

gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, GLib  # noqa: E402
from PIL import Image  # noqa: E402

CONFIG = os.environ["BAR_ICONS_CONFIG"]            # the repo's icon-sizes.json (Save writes it)
DEFAULT = os.environ["BAR_ICONS_DEFAULT"]          # the same file as built, if the repo isn't there
PINNED = os.environ["BAR_ICONS_PINNED"]            # Home Manager's launcher-N/<app>.desktop files
TRAY = os.environ["BAR_ICONS_TRAY"]                # files/icons/tailscale
XFCONF = os.environ.get("XFCONF_QUERY", "xfconf-query")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "bar-icons")
PANEL = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "xfce4", "panel")
ICON_DIRS = [os.path.expanduser("~/.local/share/icons"), os.path.expanduser("~/.icons"),
             os.path.expanduser("~/.nix-profile/share/icons"), "/usr/local/share/icons", "/usr/share/icons"]

# tray glyphs: (label, icon names). Babbage's own (files/icons/tailscale) or the icon theme's
# (Clipman's clipboard, Telegram's symbolic icons). A group shares one size, measured on its first
# icon (the fullest shape); the others scale by the same factors, so Wi-Fi's weaker levels stay
# smaller
TRAY_GROUPS = [
    ("Clipboard", ["clipman"]),
    ("1Password", ["menubar-1password"]),
    ("Hex", ["menubar-hex"]),
    ("Wi-Fi", ["menubar-wifi-3", "menubar-wifi-2", "menubar-wifi-1", "menubar-wifi-0"]),
    ("Telegram", ["org.telegram.desktop-symbolic", "org.telegram.desktop-mute-symbolic",
                  "org.telegram.desktop-attention-symbolic"]),
    ("Tailscale", ["tailscale-connected", "tailscale-disconnected"]),
]


def xfconf(channel, prop):
    try:
        out = subprocess.run([XFCONF, "-c", channel, "-p", prop], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout if out.returncode == 0 else None


def slot():
    """The bar's icon size: every pinned icon and tray glyph is drawn in a square this big."""
    v = xfconf("xfce4-panel", "/panels/panel-1/icon-size")
    return int(v) if v and v.strip().isdigit() and int(v) > 0 else 30


def load_sizes():
    path = CONFIG if os.path.exists(CONFIG) else DEFAULT
    with open(path) as f:
        data = json.load(f)
    return {"pinned": dict(data.get("pinned", {})), "tray": dict(data.get("tray", {}))}


def save_sizes(sizes):
    data = {k: {name: list(wh) for name, wh in sorted(sizes[k].items())} for k in ("pinned", "tray")}
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, CONFIG)


# ---- artwork --------------------------------------------------------------------------------
def find_icon(name):
    """The largest file for an icon name: the icon theme first, then hicolor, then pixmaps."""
    if os.path.isabs(name):
        return name if os.path.exists(name) else None
    theme = (xfconf("xsettings", "/Net/IconThemeName") or "hicolor").strip()
    for t in dict.fromkeys([theme, "hicolor"]):
        best, best_size = None, -1
        for base in ICON_DIRS:
            for path in glob.glob(os.path.join(base, t, "**", f"{name}.*"), recursive=True):
                if not path.endswith((".png", ".svg")):
                    continue
                m = re.search(r"/(\d+)x\d+/", path)
                size = 100000 if "/scalable/" in path else int(m.group(1)) if m else 0
                if size > best_size:
                    best, best_size = path, size
        if best:
            return best
    for ext in ("png", "svg"):
        path = f"/usr/share/pixmaps/{name}.{ext}"
        if os.path.exists(path):
            return path
    return None


def load(path, size):
    """An image file (PNG or SVG) as an RGBA PIL image, `size` px on its longer side."""
    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(path, size, size)
    if not pb.get_has_alpha():
        pb = pb.add_alpha(False, 0, 0, 0)
    return Image.frombuffer("RGBA", (pb.get_width(), pb.get_height()), pb.get_pixels(), "raw", "RGBA",
                            pb.get_rowstride(), 1).copy()


def visible_box(img):
    """Bounding box of the drawn (not see-through) part."""
    return img.split()[3].point(lambda v: 255 if v > 20 else 0).getbbox() or (0, 0, img.width, img.height)


def natural(img, s):
    """(width, height, centre x, centre y) of the artwork when the whole image is drawn in an s px slot."""
    x0, y0, x1, y1 = visible_box(img)
    k = s / max(img.width, img.height)
    return (x1 - x0) * k, (y1 - y0) * k, (x0 + x1) / 2 * k, (y0 + y1) / 2 * k


# ---- pinned apps ----------------------------------------------------------------------------
def pinned_apps():
    """[(app file, name, icon name)] in bar order, from Home Manager's launcher files."""
    files = {}   # launcher id -> app file
    for path in glob.glob(os.path.join(PINNED, "launcher-*", "*.desktop")):
        files[int(path.split("launcher-")[1].split("/")[0])] = os.path.basename(path)
    order = []
    ids = xfconf("xfce4-panel", "/panels/panel-1/plugin-ids") or ""
    for line in ids.splitlines():
        if line.strip().isdigit() and int(line) in files:
            order.append(files[int(line)])
    order += [f for _, f in sorted(files.items()) if f not in order]
    apps = []
    for app in dict.fromkeys(order):
        src = next(p for p in glob.glob(os.path.join(PINNED, "launcher-*", app)))
        entry = configparser.ConfigParser(interpolation=None)
        entry.optionxform = str
        entry.read(src)
        d = entry["Desktop Entry"]
        apps.append((app, d.get("Name", app), d.get("Icon", "")))
    return apps


def draw_pinned(img, wh, s):
    """The artwork `img` (load(path, 512)) at wh=(width, height) px in an s px square, centred
    where the artwork's own centre is: exactly what the bar shows."""
    x0, y0, x1, y1 = visible_box(img)
    _, _, cx, cy = natural(img, s)
    w, h = (max(1, min(s, round(v))) for v in wh)
    art = img.crop((x0, y0, x1, y1)).resize((w, h), Image.LANCZOS)
    canvas = Image.new("RGBA", (s, s))
    canvas.paste(art, (min(max(0, round(cx - w / 2)), s - w), min(max(0, round(cy - h / 2)), s - h)))
    return canvas


def render_pinned(app, icon, wh, s):
    """Draw the app's icon at wh=(width, height) px in an s px square; returns the PNG's path."""
    path = find_icon(icon)
    if not path:
        return None
    w, h = (max(1, min(s, round(v))) for v in wh)
    key = hashlib.sha1(f"{path}:{os.stat(path).st_mtime_ns}:{w}x{h}:{s}".encode()).hexdigest()[:10]
    out_dir = os.path.join(STATE, "pinned")
    out = os.path.join(out_dir, f"{app[:-len('.desktop')]}-{key}.png")
    if not os.path.exists(out):
        os.makedirs(out_dir, exist_ok=True)
        draw_pinned(load(path, 512), (w, h), s).save(out, optimize=True)
    for old in glob.glob(os.path.join(out_dir, f"{app[:-len('.desktop')]}-*.png")):
        if old != out:
            os.remove(old)
    return out


def set_launcher_icon(app, icon):
    """Point every live launcher of `app` on the bar(s) at `icon` (a name or a file)."""
    for path in glob.glob(os.path.join(PANEL, "launcher-*", app)):
        with open(path) as f:
            text = f.read()
        new = re.sub(r"(?m)^Icon=.*$", f"Icon={icon}", text)
        if new != text:
            with open(path, "w") as f:
                f.write(new)


def apply_pinned(sizes, s):
    for app, _name, icon in pinned_apps():
        wh = sizes["pinned"].get(app)
        drawn = render_pinned(app, icon, wh, s) if wh else None
        set_launcher_icon(app, drawn or icon)
        if not wh:
            for old in glob.glob(os.path.join(STATE, "pinned", f"{app[:-len('.desktop')]}-*.png")):
                os.remove(old)


# ---- tray glyphs ----------------------------------------------------------------------------
def tray_source(name):
    """The SVG a tray icon is drawn from: Babbage's glyph, else the icon theme's; None if neither."""
    own = os.path.join(TRAY, f"{name}.svg")
    if os.path.exists(own):
        return own
    path = find_icon(name)
    return path if path and path.endswith(".svg") else None


def scaled_svg(svg, cx, cy, sx, sy):
    """The SVG with its drawing scaled by (sx, sy) around (cx, cy), in its own units."""
    m = re.search(r"<svg\b[^>]*>", svg)
    end = svg.rfind("</svg>")
    t = f"translate({cx:.3f} {cy:.3f}) scale({sx:.4f} {sy:.4f}) translate({-cx:.3f} {-cy:.3f})"
    return f'{svg[:m.end()]}<g transform="{t}">{svg[m.end():end]}</g>{svg[end:]}'


def svg_units(svg, s):
    """SVG user units per bar pixel, from its viewBox (the glyphs are 30x30 viewBox at 30px)."""
    m = re.search(r'viewBox="\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)[\s,]+([\d.]+)', svg)
    return (float(m.group(1)) / s) if m else 1.0


def scaled_tray(names, wh, s):
    """{file name: SVG text} for a tray group drawn at wh=(width, height) px (measured on its
    first glyph; the others scale by the same factors)."""
    w0, h0, cx, cy = natural(load(tray_source(names[0]), s), s)
    sx, sy = wh[0] / w0, wh[1] / h0
    out = {}
    for name in names:
        if not tray_source(name):
            continue
        with open(tray_source(name)) as f:
            svg = f.read()
        u = svg_units(svg, s)
        out[name] = scaled_svg(svg, cx * u, cy * u, sx, sy)
    return out


def apply_tray(sizes, s):
    out_dir = os.path.join(STATE, "tray")
    os.makedirs(out_dir, exist_ok=True)
    wanted = set()
    for label, names in TRAY_GROUPS:
        wh = sizes["tray"].get(label)
        if not wh or not tray_source(names[0]):
            continue
        for name, text in scaled_tray(names, wh, s).items():
            out = os.path.join(out_dir, f"{name}.svg")
            wanted.add(out)
            if not os.path.exists(out) or open(out).read() != text:
                with open(out + ".tmp", "w") as f:
                    f.write(text)
                os.replace(out + ".tmp", out)   # menubar-popovers watches this directory
    for old in glob.glob(os.path.join(out_dir, "*.svg")):
        if old not in wanted:
            os.remove(old)


def apply(sizes):
    s = slot()
    apply_pinned(sizes, s)
    apply_tray(sizes, s)


# ---- the window -----------------------------------------------------------------------------
ZOOM = 3          # the preview shows the bar 3x, pixel for pixel (2x if that doesn't fit)
MIN = 4           # smallest size (px)
HANDLE = 7        # preview px around an edge that grabs it
RULER = 44        # preview px left of the bar: the ruler of bar rows (px from the bar's top)
TOP = 34          # preview px above the bar: the ruler of screen columns
GAP = 56          # preview px between the two parts of the bar shown (they're far apart)
MARGIN = 12       # bar px shown either side of each part


def to_pixbuf(img):
    return GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(img.tobytes()), GdkPixbuf.Colorspace.RGB,
                                           True, 8, img.width, img.height, img.width * 4)


def to_image(pb):
    mode = "RGBA" if pb.get_has_alpha() else "RGB"
    return Image.frombuffer(mode, (pb.get_width(), pb.get_height()), pb.get_pixels(), "raw", mode,
                            pb.get_rowstride(), 1).convert("RGBA")


def svg_image(text, s):
    loader = GdkPixbuf.PixbufLoader()
    loader.set_size(s, s)
    loader.write(text.encode())
    loader.close()
    return to_image(loader.get_pixbuf())


def placed(it, wh, s):
    """(left, top, width, height) of an icon's drawn art in its s px slot, in bar px: where
    draw_pinned puts a set size, wherever the artwork puts its own size."""
    (w, h), (cx, cy) = wh, it["centre"]
    if wh == it["nat"]:
        return cx - w / 2, cy - h / 2, w, h
    return min(max(0, round(cx - w / 2)), s - w), min(max(0, round(cy - h / 2)), s - h), w, h


def bar_layout():
    """The primary bar on screen, over AT-SPI (its plugin box has one child per plugin, in
    plugin-ids order): {"bar": (x, y, w, h), "pinned": {app file: launcher button (x, y, w, h)},
    "tray": the tray's (x, y, w, h)}."""
    gi.require_version("Atspi", "2.0")
    from gi.repository import Atspi
    ids = [int(v) for v in map(str.strip, (xfconf("xfce4-panel", "/panels/panel-1/plugin-ids") or "").splitlines())
           if v.isdigit()]
    kinds = {i: (xfconf("xfce4-panel", f"/plugins/plugin-{i}") or "").strip() for i in ids}
    files = {}
    for path in glob.glob(os.path.join(PINNED, "launcher-*", "*.desktop")):
        files[int(path.split("launcher-")[1].split("/")[0])] = os.path.basename(path)
    desk = Atspi.get_desktop(0)
    for i in range(desk.get_child_count()):
        app = desk.get_child_at_index(i)
        if not app or app.get_name() != "xfce4-panel":
            continue
        queue = [app]
        while queue:
            node = queue.pop(0)
            try:
                n = node.get_child_count()
            except GLib.Error:
                continue
            if n == len(ids) and n > 3:
                e = node.get_extents(Atspi.CoordType.SCREEN)
                out = {"bar": (e.x, e.y, e.width, e.height), "pinned": {}, "tray": None}
                for k, pid in enumerate(ids):
                    e = node.get_child_at_index(k).get_extents(Atspi.CoordType.SCREEN)
                    box = (e.x, e.y, e.width, e.height)
                    if pid in files:
                        out["pinned"][files[pid]] = box
                    elif kinds[pid] == "systray":
                        out["tray"] = box
                return out
            queue.extend(c for c in (node.get_child_at_index(k) for k in range(n)) if c)
    return None


def window():
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gtk
    import cairo

    s = slot()
    saved = load_sizes()
    sizes = json.loads(json.dumps(saved))
    layout = bar_layout()
    if not layout or not layout["pinned"]:
        dlg = Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.CLOSE,
                                text="Can't find the menu bar")
        dlg.format_secondary_text("Bar Icon Sizes reads the bar's layout over accessibility (AT-SPI).")
        dlg.run()
        return
    bx, by, bw, bh = layout["bar"]
    root = Gdk.get_default_root_window()

    # the two parts of the bar shown, in screen px: the pinned apps and the tray
    buttons = layout["pinned"].values()
    parts = [[min(b[0] for b in buttons) - MARGIN, max(b[0] + b[2] for b in buttons) + MARGIN]]
    if layout["tray"]:
        tx, _, tw, _ = layout["tray"]
        parts.append([tx - MARGIN, tx + tw + MARGIN])
    screen_w = Gdk.Display.get_default().get_monitor_at_point(bx + 1, by + 1).get_geometry().width
    Z = ZOOM if RULER + sum(p[1] - p[0] for p in parts) * ZOOM + GAP < screen_w * 0.95 else 2
    x = RULER
    for p in parts:
        p.append(x)                      # preview x of the part's left edge
        x += (p[1] - p[0]) * Z + GAP
    width, height = x - GAP + 8, TOP + bh * Z + 40

    def to_preview(sx, sy):
        """Screen px -> preview px."""
        for x0, x1, px in parts:
            if x0 <= sx <= x1:
                return px + (sx - x0) * Z, TOP + (sy - by) * Z
        return None

    # the icons that can be resized, with their slot's top-left on screen
    items = []
    for app, name, icon in pinned_apps():
        path = find_icon(icon)
        box = layout["pinned"].get(app)
        if not path or not box:
            continue
        img = load(path, 512)
        w, h, cx, cy = natural(img, s)
        # the launcher draws its icon 7px in from its button's right (gtk.css: padding 0 7px;
        # Ghostty's button has 1px more on the left)
        items.append(dict(kind="pinned", key=app, label=name, nat=(w, h), centre=(cx, cy), src=img,
                          slot=(box[0] + box[2] - 7 - s, by + (bh - s) // 2)))
    tray_items = []
    for label, names in TRAY_GROUPS:
        if tray_source(names[0]):
            w, h, cx, cy = natural(load(tray_source(names[0]), s), s)
            tray_items.append(dict(kind="tray", key=label, label=label, nat=(w, h), centre=(cx, cy),
                                   names=names, slot=None))

    state = {"sel": 0, "drag": None, "shot": [], "stale": set()}
    pending = []

    def size_of(it):
        wh = sizes[it["kind"]].get(it["key"])
        return (wh[0], wh[1]) if wh else it["nat"]

    def exact(it, wh, name=None):
        """What the bar draws for it (or the group's icon `name`) at wh, as an s x s image (tray
        glyphs in white, as the tray draws symbolic icons)."""
        if it["kind"] == "pinned":
            return draw_pinned(it["src"], wh, s)
        name = name or it["names"][0]
        if wh == it["nat"]:
            img = load(tray_source(name), s)
        else:
            img = svg_image(scaled_tray(it["names"], wh, s)[name], s)
        white = Image.new("RGBA", img.size, "white")
        white.putalpha(img.split()[3])
        return white

    def capture():
        """Grab the bar's parts off the screen, and find which tray icon is which (the tray
        packs its icons side by side; ours are matched by shape)."""
        state["shot"] = []
        for x0, x1, _px in parts:
            pb = Gdk.pixbuf_get_from_window(root, x0, by, x1 - x0, bh)
            state["shot"].append(pb.scale_simple(pb.get_width() * Z, pb.get_height() * Z,
                                                 GdkPixbuf.InterpType.NEAREST))
        if layout["tray"]:
            tx, _, tw, _ = layout["tray"]
            shot = to_image(Gdk.pixbuf_get_from_window(root, tx, by, tw, bh)).convert("L")
            cols = [max(shot.getpixel((c, r)) for r in range(bh)) > 90 for c in range(tw)]
            runs, start = [], None
            for c, on in enumerate(cols + [False]):
                if on and start is None:
                    start = c
                elif not on and start is not None:
                    if runs and start - runs[-1][1] <= 3:
                        runs[-1][1] = c
                    else:
                        runs.append([start, c])
                    start = None
            top = (bh - s) // 2
            for it in tray_items:
                on_bar = sizes["tray"].get(it["key"])
                # the tray draws glyphs in white on the black bar: compare each of the group's
                # shapes (alpha) with the bar's brightness
                wants = [exact(it, tuple(on_bar) if on_bar else it["nat"], n).split()[3]
                         for n in it["names"] if tray_source(n)]
                best, best_score = None, 1e9
                for a, b in runs:
                    left = round((a + b) / 2 - s / 2)
                    crop = shot.crop((left, top, left + s, top + s))
                    data = crop.tobytes()
                    score = min(sum(abs(p - q) for p, q in zip(data, w.tobytes())) for w in wants) / (s * s)
                    if score < best_score:
                        best, best_score = left, score
                it["slot"] = (tx + best, by + top) if best is not None and best_score < 25 else None
        current = items[state["sel"]] if items else None
        items[:] = [it for it in items if it["kind"] == "pinned"] + [it for it in tray_items if it["slot"]]
        state["sel"] = items.index(current) if current in items else 0
        state["stale"].clear()

    def rect(it):
        """The icon's art in the preview (px)."""
        left, top, w, h = placed(it, size_of(it), s)
        px, py = to_preview(*it["slot"])
        return px + left * Z, py + top * Z, w * Z, h * Z

    # ---- drawing
    def draw(_area, cr):
        cr.set_source_rgb(0.15, 0.15, 0.16)
        cr.paint()
        cr.select_font_face("Inter", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.set_line_width(1)
        # the bar itself, as it is on screen, under a ruler of screen columns (tick every 2px,
        # numbered every 20)
        for (x0, x1, px), pb in zip(parts, state["shot"]):
            Gdk.cairo_set_source_pixbuf(cr, pb, px, TOP)
            cr.paint()
            for sx in range(x0 + x0 % 2, x1 + 1, 2):
                X = px + (sx - x0) * Z + 0.5
                major = sx % 10 == 0
                cr.set_source_rgba(1, 1, 1, 0.7 if major else 0.3)
                cr.move_to(X, TOP - (10 if major else 5))
                cr.line_to(X, TOP)
                cr.stroke()
                if sx % 20 == 0:
                    cr.set_font_size(10)
                    ext = cr.text_extents(str(sx))
                    cr.move_to(X - ext.width / 2, TOP - 14)
                    cr.show_text(str(sx))
        # bar rows down the left: px from the bar's top, every px, numbered every 6
        for r in range(bh + 1):
            Y = TOP + r * Z + 0.5
            major = r % 6 == 0
            cr.set_source_rgba(1, 1, 1, 0.75 if major else 0.3)
            cr.move_to(RULER - (12 if major else 6), Y)
            cr.line_to(RULER, Y)
            cr.stroke()
            if major:
                cr.set_font_size(10)
                ext = cr.text_extents(str(r))
                cr.move_to(RULER - 16 - ext.width, Y + ext.height / 2)
                cr.show_text(str(r))
        sel = items[state["sel"]] if items else None
        for it in items:
            px, py = to_preview(*it["slot"])
            if (it["kind"], it["key"]) in state["stale"]:
                # changed, and the bar hasn't caught up yet: draw what it's about to show
                cr.set_source_rgb(0, 0, 0)
                cr.rectangle(px, py, s * Z, s * Z)
                cr.fill()
                Gdk.cairo_set_source_pixbuf(cr, to_pixbuf(exact(it, size_of(it)).resize((s * Z, s * Z), Image.NEAREST)),
                                            px, py)
                cr.paint()
            w, h = size_of(it)
            t = f"{round(w)}×{round(h)}"
            cr.set_font_size(11)
            cr.select_font_face("Inter", cairo.FONT_SLANT_NORMAL,
                                cairo.FONT_WEIGHT_BOLD if it is sel else cairo.FONT_WEIGHT_NORMAL)
            ext = cr.text_extents(t)
            if it is sel:
                cr.set_source_rgb(0.04, 0.52, 1.0)
            else:
                cr.set_source_rgba(1, 1, 1, 0.9 if it["key"] in sizes[it["kind"]] else 0.5)
            cr.move_to(px + (s * Z - ext.width) / 2, TOP + bh * Z + 20)
            cr.show_text(t)
        if sel:
            rx, ry, rw, rh = rect(sel)
            # guides: its default size's top and bottom along the whole bar, fixed while you
            # resize it, to see how far it is from its default and line the others up
            _l, dtop, _w, dh = placed(sel, sel["nat"], s)
            _px, py = to_preview(*sel["slot"])
            cr.set_source_rgba(0.04, 0.52, 1.0, 0.75)
            cr.set_dash([4, 4])
            for y in (round(py + dtop * Z) + 0.5, round(py + (dtop + dh) * Z) - 0.5):
                for x0, x1, px in parts:
                    cr.move_to(px, y)
                    cr.line_to(px + (x1 - x0) * Z, y)
                    cr.stroke()
            cr.set_dash([])
            cr.set_source_rgb(0.04, 0.52, 1.0)
            cr.rectangle(round(rx) + 0.5, round(ry) + 0.5, round(rw) - 1, round(rh) - 1)
            cr.stroke()
            for hx in (rx, rx + rw / 2, rx + rw):
                for hy in (ry, ry + rh / 2, ry + rh):
                    if (hx, hy) != (rx + rw / 2, ry + rh / 2):
                        cr.rectangle(round(hx) - 3, round(hy) - 3, 6, 6)
            cr.fill()
        return False

    # ---- changing a size
    def set_size(it, w, h, keep=None):
        """Set it to w x h (clamped), keeping the proportions if linked; `keep` says which side
        the user moved ("w", "h" or None for whichever changed more)."""
        nw, nh = it["nat"]
        if link.get_active():
            ratio = nh / nw
            if keep is None:
                cw, ch = size_of(it)
                keep = "w" if abs(w - cw) / max(cw, 1) >= abs(h - ch) / max(ch, 1) else "h"
            if keep == "w":
                h = w * ratio
            else:
                w = h / ratio
        w, h = (int(min(s, max(MIN, round(v)))) for v in (w, h))
        sizes[it["kind"]][it["key"]] = [w, h]
        changed(it)

    def changed(it=None):
        state["stale"].update((i["kind"], i["key"]) for i in ([it] if it is not None else items))
        area.queue_draw()
        sync_inspector()
        if not pending:
            pending.append(GLib.timeout_add(150, run_apply))

    def run_apply():
        pending.clear()
        apply(sizes)
        update_buttons()
        GLib.timeout_add(500, recapture)   # once the bar has redrawn
        return False

    def recapture():
        if not pending and not state["drag"]:
            capture()
            area.queue_draw()
            sync_inspector()
        return False

    # ---- mouse: click an icon to pick it, drag its edges or corners to resize it
    def edges_at(it, px, py):
        rx, ry, rw, rh = rect(it)
        if not (rx - HANDLE <= px <= rx + rw + HANDLE and ry - HANDLE <= py <= ry + rh + HANDLE):
            return ""
        e = "l" if abs(px - rx) <= HANDLE else "r" if abs(px - (rx + rw)) <= HANDLE else ""
        e += "t" if abs(py - ry) <= HANDLE else "b" if abs(py - (ry + rh)) <= HANDLE else ""
        return e

    def on_press(_a, ev):
        win.set_focus(None)          # arrow keys go to the bar, not a spin button
        if not items:
            return True
        sel = items[state["sel"]]
        e = edges_at(sel, ev.x, ev.y)
        if e:
            state["drag"] = (e, ev.x, ev.y, size_of(sel))
            return True
        for i, it in enumerate(items):
            px, _py = to_preview(*it["slot"])
            if px <= ev.x <= px + s * Z and TOP <= ev.y <= TOP + bh * Z + 26:
                state["sel"] = i
                area.queue_draw()
                sync_inspector()
                break
        return True

    def on_motion(_a, ev):
        drag = state["drag"]
        sel = items[state["sel"]] if items else None
        if not drag:
            e = edges_at(sel, ev.x, ev.y) if sel else ""
            cursor = {"l": "ew-resize", "r": "ew-resize", "t": "ns-resize", "b": "ns-resize",
                      "lt": "nwse-resize", "rb": "nwse-resize", "rt": "nesw-resize", "lb": "nesw-resize"}.get(e)
            win.get_window().set_cursor(Gdk.Cursor.new_from_name(win.get_display(), cursor) if cursor else None)
            return True
        e, x0, y0, (w0, h0) = drag
        dx, dy = (ev.x - x0) / Z, (ev.y - y0) / Z
        w = w0 + (2 * dx if "r" in e else -2 * dx if "l" in e else 0)   # the icon stays centred,
        h = h0 + (2 * dy if "b" in e else -2 * dy if "t" in e else 0)   # so both sides move
        set_size(sel, w, h, "w" if e in ("l", "r") else "h" if e in ("t", "b") else None)
        return True

    def on_release(_a, _ev):
        state["drag"] = None
        return True

    # ---- keys: ←/→ pick, ↑/↓ height, Shift+↑/↓ width (the other follows when linked)
    def on_key(_w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            win.close()
            return True
        if not items or isinstance(win.get_focus(), Gtk.SpinButton):
            return False
        if ev.keyval in (Gdk.KEY_Left, Gdk.KEY_Right):
            state["sel"] = (state["sel"] + (1 if ev.keyval == Gdk.KEY_Right else -1)) % len(items)
            area.queue_draw()
            sync_inspector()
            return True
        if ev.keyval in (Gdk.KEY_Up, Gdk.KEY_Down):
            it, step = items[state["sel"]], 1 if ev.keyval == Gdk.KEY_Up else -1
            w, h = size_of(it)
            if ev.state & Gdk.ModifierType.SHIFT_MASK:
                set_size(it, round(w) + step, h, "w")
            else:
                set_size(it, w, round(h) + step, "h")
            return True
        return False

    # ---- layout
    win = Gtk.Window(title="Bar icon sizes")
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_type_hint(Gdk.WindowTypeHint.DIALOG)   # i3 floats dialogs (files/i3/config)
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=16)
    win.add(outer)
    hint = Gtk.Label(xalign=0, wrap=True)
    hint.set_markup(f"<small>Your bar as it is on screen, {Z}× (the pinned apps, then the tray). The "
                    "rulers count real pixels: screen columns along the top, px from the bar's top "
                    "down the side. Click an icon, then drag its edges or corners, or use ↑/↓ "
                    "(height) and Shift+↑/↓ (width); ←/→ pick the next one. The bar follows as you "
                    "go.</small>")
    outer.pack_start(hint, False, False, 0)

    area = Gtk.DrawingArea()
    area.set_size_request(width, height)
    area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                    | Gdk.EventMask.POINTER_MOTION_MASK)
    area.connect("draw", draw)
    area.connect("button-press-event", on_press)
    area.connect("motion-notify-event", on_motion)
    area.connect("button-release-event", on_release)
    outer.pack_start(area, False, False, 0)

    inspector = Gtk.Box(spacing=8)
    name = Gtk.Label(xalign=0)
    ws = Gtk.SpinButton.new_with_range(MIN, s, 1)
    hs = Gtk.SpinButton.new_with_range(MIN, s, 1)
    link = Gtk.CheckButton(label="Keep proportions", active=True, can_focus=False)
    reset = Gtk.Button(label="Reset", tooltip_text="Back to the artwork's own size", can_focus=False)
    revert_b = Gtk.Button(label="Revert", can_focus=False)
    save_b = Gtk.Button(label="Save", can_focus=False)
    save_b.get_style_context().add_class("suggested-action")
    for widget in (name, Gtk.Label(label="  W"), ws, Gtk.Label(label="H"), hs, link, reset):
        inspector.pack_start(widget, False, False, 0)
    inspector.pack_end(save_b, False, False, 0)
    inspector.pack_end(revert_b, False, False, 0)
    outer.pack_start(inspector, False, False, 0)
    status = Gtk.Label(xalign=0)
    outer.pack_start(status, False, False, 0)

    busy = []

    def sync_inspector():
        if not items:
            return
        it = items[state["sel"]]
        w, h = size_of(it)
        name.set_markup(f"<b>{GLib.markup_escape_text(it['label'])}</b>")
        busy.append(1)
        ws.set_value(round(w))
        hs.set_value(round(h))
        busy.clear()

    def on_spin(spin):
        if busy or not items:
            return
        set_size(items[state["sel"]], ws.get_value(), hs.get_value(), "w" if spin is ws else "h")

    def on_reset(_b):
        if items:
            it = items[state["sel"]]
            sizes[it["kind"]].pop(it["key"], None)
            changed(it)

    def dirty():
        return sizes != saved

    def update_buttons():
        save_b.set_sensitive(dirty())
        revert_b.set_sensitive(dirty())

    def do_save(_b):
        save_sizes(sizes)
        saved.clear()
        saved.update(json.loads(json.dumps(sizes)))
        status.set_markup(f"<small>Saved to {GLib.markup_escape_text(os.path.relpath(CONFIG, os.path.expanduser('~')))}"
                          " (commit it to keep it in git)</small>")
        update_buttons()

    def do_revert(_b):
        for k in ("pinned", "tray"):
            sizes[k] = dict(saved[k])
        status.set_text("")
        changed()

    def on_close(_w, _e):
        if not dirty():
            return False
        dlg = Gtk.MessageDialog(transient_for=win, modal=True, message_type=Gtk.MessageType.QUESTION,
                                text="Save the new icon sizes?")
        dlg.format_secondary_text("If you don't, the bar goes back to the saved sizes.")
        dlg.add_buttons("Don't Save", Gtk.ResponseType.NO, "Cancel", Gtk.ResponseType.CANCEL,
                        "Save", Gtk.ResponseType.YES)
        answer = dlg.run()
        dlg.destroy()
        if answer in (Gtk.ResponseType.CANCEL, Gtk.ResponseType.DELETE_EVENT):
            return True
        if answer == Gtk.ResponseType.YES:
            do_save(None)
        else:
            apply(saved)
        return False

    ws.connect("value-changed", on_spin)
    hs.connect("value-changed", on_spin)
    reset.connect("clicked", on_reset)
    save_b.connect("clicked", do_save)
    revert_b.connect("clicked", do_revert)
    win.connect("delete-event", on_close)
    win.connect("destroy", Gtk.main_quit)
    win.connect("key-press-event", on_key)
    capture()
    sync_inspector()
    update_buttons()
    win.show_all()
    GLib.idle_add(lambda: win.set_focus(None))   # GTK focuses the first spin button on show; the
                                                # arrow keys belong to the bar
    Gtk.main()


def main():
    if sys.argv[1:] == ["apply"]:
        apply(load_sizes())
        return 0
    if sys.argv[1:]:
        print(__doc__.strip())
        return 2
    window()
    return 0


if __name__ == "__main__":
    sys.exit(main())
