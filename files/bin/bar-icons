#!/usr/bin/env python3
"""Bar icon sizes: the width and height of each pinned app's icon and each tray glyph on the
menu bar, changed live and saved to the Babbage repo.

  bar-icons          a window with one row per icon: width and height in px (linked to keep
                     the proportions, or not) and Reset. The bar changes as you go; Save writes
                     the sizes to the repo (files/panel/icon-sizes.json), Revert goes back to
                     the saved ones.
  bar-icons apply    draws the saved sizes on the bar; Home Manager runs it after every switch.

A size is the icon's visible size inside the bar's icon slot (xfce4-panel icon-size, 30px), so
at most the slot. Icons without one keep their artwork's own size. A pinned app gets a PNG
drawn at exactly that size, and its launcher's Icon= points at it (the launcher plugin
notices the file change). A tray glyph (files/icons/tailscale) gets a scaled copy of its SVG in
the state directory, which files/bin/menubar-popovers watches and shows instead.
"""
import configparser
import glob
import hashlib
import json
import os
import re
import subprocess
import sys

import gi

gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, GLib  # noqa: E402
from PIL import Image  # noqa: E402

CONFIG = os.environ["BAR_ICONS_CONFIG"]            # the repo's icon-sizes.json (Save writes it)
DEFAULT = os.environ["BAR_ICONS_DEFAULT"]          # the same file as built, if the repo isn't there
PINNED = os.environ["BAR_ICONS_PINNED"]            # Home Manager's launcher-N/<app>.desktop files
TRAY = os.environ["BAR_ICONS_TRAY"]                # files/icons/tailscale
XFCONF = os.environ.get("XFCONF_QUERY", "xfconf-query")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "bar-icons")
PANEL = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "xfce4", "panel")
ICON_DIRS = [os.path.expanduser("~/.local/share/icons"), os.path.expanduser("~/.icons"),
             os.path.expanduser("~/.nix-profile/share/icons"), "/usr/local/share/icons", "/usr/share/icons"]

# tray glyphs: (label, files). A group shares one size, measured on its first file (the
# fullest shape); the others scale by the same factors, so Wi-Fi's weaker levels stay smaller
TRAY_GROUPS = [
    ("1Password", ["menubar-1password"]),
    ("Hex", ["menubar-hex"]),
    ("Wi-Fi", ["menubar-wifi-3", "menubar-wifi-2", "menubar-wifi-1", "menubar-wifi-0"]),
    ("Tailscale", ["tailscale-connected", "tailscale-disconnected"]),
]


def xfconf(channel, prop):
    try:
        out = subprocess.run([XFCONF, "-c", channel, "-p", prop], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout if out.returncode == 0 else None


def slot():
    """The bar's icon size: every pinned icon and tray glyph is drawn in a square this big."""
    v = xfconf("xfce4-panel", "/panels/panel-1/icon-size")
    return int(v) if v and v.strip().isdigit() and int(v) > 0 else 30


def load_sizes():
    path = CONFIG if os.path.exists(CONFIG) else DEFAULT
    with open(path) as f:
        data = json.load(f)
    return {"pinned": dict(data.get("pinned", {})), "tray": dict(data.get("tray", {}))}


def save_sizes(sizes):
    data = {k: {name: list(wh) for name, wh in sorted(sizes[k].items())} for k in ("pinned", "tray")}
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, CONFIG)


# ---- artwork --------------------------------------------------------------------------------
def find_icon(name):
    """The largest file for an icon name: the icon theme first, then hicolor, then pixmaps."""
    if os.path.isabs(name):
        return name if os.path.exists(name) else None
    theme = (xfconf("xsettings", "/Net/IconThemeName") or "hicolor").strip()
    for t in dict.fromkeys([theme, "hicolor"]):
        best, best_size = None, -1
        for base in ICON_DIRS:
            for path in glob.glob(os.path.join(base, t, "**", f"{name}.*"), recursive=True):
                if not path.endswith((".png", ".svg")):
                    continue
                m = re.search(r"/(\d+)x\d+/", path)
                size = 100000 if "/scalable/" in path else int(m.group(1)) if m else 0
                if size > best_size:
                    best, best_size = path, size
        if best:
            return best
    for ext in ("png", "svg"):
        path = f"/usr/share/pixmaps/{name}.{ext}"
        if os.path.exists(path):
            return path
    return None


def load(path, size):
    """An image file (PNG or SVG) as an RGBA PIL image, `size` px on its longer side."""
    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(path, size, size)
    if not pb.get_has_alpha():
        pb = pb.add_alpha(False, 0, 0, 0)
    return Image.frombuffer("RGBA", (pb.get_width(), pb.get_height()), pb.get_pixels(), "raw", "RGBA",
                            pb.get_rowstride(), 1).copy()


def visible_box(img):
    """Bounding box of the drawn (not see-through) part."""
    return img.split()[3].point(lambda v: 255 if v > 20 else 0).getbbox() or (0, 0, img.width, img.height)


def natural(img, s):
    """(width, height, centre x, centre y) of the artwork when the whole image is drawn in an s px slot."""
    x0, y0, x1, y1 = visible_box(img)
    k = s / max(img.width, img.height)
    return (x1 - x0) * k, (y1 - y0) * k, (x0 + x1) / 2 * k, (y0 + y1) / 2 * k


# ---- pinned apps ----------------------------------------------------------------------------
def pinned_apps():
    """[(app file, name, icon name)] in bar order, from Home Manager's launcher files."""
    files = {}   # launcher id -> app file
    for path in glob.glob(os.path.join(PINNED, "launcher-*", "*.desktop")):
        files[int(path.split("launcher-")[1].split("/")[0])] = os.path.basename(path)
    order = []
    ids = xfconf("xfce4-panel", "/panels/panel-1/plugin-ids") or ""
    for line in ids.splitlines():
        if line.strip().isdigit() and int(line) in files:
            order.append(files[int(line)])
    order += [f for _, f in sorted(files.items()) if f not in order]
    apps = []
    for app in dict.fromkeys(order):
        src = next(p for p in glob.glob(os.path.join(PINNED, "launcher-*", app)))
        entry = configparser.ConfigParser(interpolation=None)
        entry.optionxform = str
        entry.read(src)
        d = entry["Desktop Entry"]
        apps.append((app, d.get("Name", app), d.get("Icon", "")))
    return apps


def render_pinned(app, icon, wh, s):
    """Draw the app's icon at wh=(width, height) px in an s px square; returns the PNG's path."""
    path = find_icon(icon)
    if not path:
        return None
    img = load(path, 512)
    x0, y0, x1, y1 = visible_box(img)
    _, _, cx, cy = natural(img, s)
    w, h = (max(1, min(s, round(v))) for v in wh)
    key = hashlib.sha1(f"{path}:{os.stat(path).st_mtime_ns}:{w}x{h}:{s}".encode()).hexdigest()[:10]
    out_dir = os.path.join(STATE, "pinned")
    out = os.path.join(out_dir, f"{app[:-len('.desktop')]}-{key}.png")
    if not os.path.exists(out):
        os.makedirs(out_dir, exist_ok=True)
        art = img.crop((x0, y0, x1, y1)).resize((w, h), Image.LANCZOS)
        canvas = Image.new("RGBA", (s, s))
        left = min(max(0, round(cx - w / 2)), s - w)
        top = min(max(0, round(cy - h / 2)), s - h)
        canvas.paste(art, (left, top))
        canvas.save(out, optimize=True)
    for old in glob.glob(os.path.join(out_dir, f"{app[:-len('.desktop')]}-*.png")):
        if old != out:
            os.remove(old)
    return out


def set_launcher_icon(app, icon):
    """Point every live launcher of `app` on the bar(s) at `icon` (a name or a file)."""
    for path in glob.glob(os.path.join(PANEL, "launcher-*", app)):
        with open(path) as f:
            text = f.read()
        new = re.sub(r"(?m)^Icon=.*$", f"Icon={icon}", text)
        if new != text:
            with open(path, "w") as f:
                f.write(new)


def apply_pinned(sizes, s):
    for app, _name, icon in pinned_apps():
        wh = sizes["pinned"].get(app)
        drawn = render_pinned(app, icon, wh, s) if wh else None
        set_launcher_icon(app, drawn or icon)
        if not wh:
            for old in glob.glob(os.path.join(STATE, "pinned", f"{app[:-len('.desktop')]}-*.png")):
                os.remove(old)


# ---- tray glyphs ----------------------------------------------------------------------------
def tray_source(name):
    return os.path.join(TRAY, f"{name}.svg")


def scaled_svg(svg, cx, cy, sx, sy):
    """The SVG with its drawing scaled by (sx, sy) around (cx, cy), in its own units."""
    m = re.search(r"<svg\b[^>]*>", svg)
    end = svg.rfind("</svg>")
    t = f"translate({cx:.3f} {cy:.3f}) scale({sx:.4f} {sy:.4f}) translate({-cx:.3f} {-cy:.3f})"
    return f'{svg[:m.end()]}<g transform="{t}">{svg[m.end():end]}</g>{svg[end:]}'


def svg_units(svg, s):
    """SVG user units per bar pixel, from its viewBox (the glyphs are 30x30 viewBox at 30px)."""
    m = re.search(r'viewBox="\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)[\s,]+([\d.]+)', svg)
    return (float(m.group(1)) / s) if m else 1.0


def apply_tray(sizes, s):
    out_dir = os.path.join(STATE, "tray")
    os.makedirs(out_dir, exist_ok=True)
    wanted = set()
    for label, names in TRAY_GROUPS:
        wh = sizes["tray"].get(label)
        if not wh or not os.path.exists(tray_source(names[0])):
            continue
        w0, h0, cx, cy = natural(load(tray_source(names[0]), s), s)
        sx, sy = wh[0] / w0, wh[1] / h0
        for name in names:
            with open(tray_source(name)) as f:
                svg = f.read()
            u = svg_units(svg, s)
            out = os.path.join(out_dir, f"{name}.svg")
            text = scaled_svg(svg, cx * u, cy * u, sx, sy)
            wanted.add(out)
            if not os.path.exists(out) or open(out).read() != text:
                with open(out + ".tmp", "w") as f:
                    f.write(text)
                os.replace(out + ".tmp", out)   # menubar-popovers watches this directory
    for old in glob.glob(os.path.join(out_dir, "*.svg")):
        if old not in wanted:
            os.remove(old)


def apply(sizes):
    s = slot()
    apply_pinned(sizes, s)
    apply_tray(sizes, s)


# ---- the window -----------------------------------------------------------------------------
ZOOM = 3          # the preview draws the bar 3x, pixel for pixel
BAR = 36          # bar height (px)
PITCH = 14        # px between icon slots on the bar (launcher padding 0 7px, files/gtk-3.0/gtk.css)
GAP = 30          # px between the pinned apps and the tray in the preview
RULER = 52        # preview px kept for the ruler on the left
MIN = 4           # smallest size (px)
HANDLE = 7        # preview px around an edge that grabs it


def to_pixbuf(img):
    return GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(img.tobytes()), GdkPixbuf.Colorspace.RGB,
                                           True, 8, img.width, img.height, img.width * 4)


def placed(it, wh, s):
    """(left, top, width, height) of an icon's drawn art in its s px slot, in bar px. A set size
    is placed the way render_pinned draws it (whole px, inside the slot); the artwork's own size
    is wherever the artwork puts it."""
    (w, h), (cx, cy) = wh, it["centre"]
    if wh == it["nat"]:
        return cx - w / 2, cy - h / 2, w, h
    return min(max(0, round(cx - w / 2)), s - w), min(max(0, round(cy - h / 2)), s - h), w, h


def window():
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gtk
    import cairo

    s, Z = slot(), ZOOM
    saved = load_sizes()
    sizes = json.loads(json.dumps(saved))

    items = []
    for kind, key, label, path in (
            [("pinned", app, name, find_icon(icon)) for app, name, icon in pinned_apps()]
            + [("tray", label, label, tray_source(names[0])) for label, names in TRAY_GROUPS]):
        if not path or not os.path.exists(path):
            continue
        img = load(path, 512)
        w, h, cx, cy = natural(img, s)
        items.append(dict(kind=kind, key=key, label=label, nat=(w, h), centre=(cx, cy),
                          art=to_pixbuf(img.crop(visible_box(img))), cache={}))
    # slot positions along the preview strip (preview px)
    x = RULER + PITCH * Z
    for i, it in enumerate(items):
        if i and it["kind"] != items[i - 1]["kind"]:
            x += GAP * Z
        it["x"] = x
        x += (s + PITCH) * Z
    width = x
    bar_top = 24
    slot_top = bar_top + (BAR - s) / 2 * Z
    height = bar_top + BAR * Z + 44

    state = {"sel": 0, "drag": None}
    pending = []

    def size_of(it):
        wh = sizes[it["kind"]].get(it["key"])
        return (wh[0], wh[1]) if wh else it["nat"]

    def rect(it):
        """The icon's art on screen (preview px)."""
        left, top, w, h = placed(it, size_of(it), s)
        return it["x"] + left * Z, slot_top + top * Z, w * Z, h * Z

    # ---- drawing
    def draw(_area, cr):
        cr.set_source_rgb(0.15, 0.15, 0.16)
        cr.paint()
        cr.set_source_rgb(0, 0, 0)                      # the bar
        cr.rectangle(RULER, bar_top, width - RULER, BAR * Z)
        cr.fill()
        cr.select_font_face("Inter", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        # ruler: one tick per bar px of the icon slot, numbered every 5
        cr.set_line_width(1)
        for p in range(s + 1):
            y = round(slot_top + p * Z) + 0.5
            long = p % 5 == 0
            cr.set_source_rgba(1, 1, 1, 0.75 if long else 0.35)
            cr.move_to(RULER - (14 if long else 7), y)
            cr.line_to(RULER, y)
            cr.stroke()
            if long:
                cr.set_font_size(11)
                t = str(p)
                ext = cr.text_extents(t)
                cr.move_to(RULER - 18 - ext.width, y + ext.height / 2)
                cr.show_text(t)
        sel = items[state["sel"]] if items else None
        for it in items:
            # the slot, faint
            cr.set_source_rgba(1, 1, 1, 0.10 if it is not sel else 0.0)
            cr.rectangle(it["x"] + 0.5, slot_top + 0.5, s * Z - 1, s * Z - 1)
            cr.stroke()
            rx, ry, rw, rh = rect(it)
            key = (round(rw), round(rh))
            pb = it["cache"].get(key)
            if pb is None:
                it["cache"].clear()
                pb = it["cache"][key] = it["art"].scale_simple(max(1, key[0]), max(1, key[1]),
                                                               GdkPixbuf.InterpType.BILINEAR)
            Gdk.cairo_set_source_pixbuf(cr, pb, round(rx), round(ry))
            cr.paint()
            # its size under it
            w, h = size_of(it)
            t = f"{round(w)}×{round(h)}"
            cr.set_font_size(12)
            cr.select_font_face("Inter", cairo.FONT_SLANT_NORMAL,
                                cairo.FONT_WEIGHT_BOLD if it is sel else cairo.FONT_WEIGHT_NORMAL)
            ext = cr.text_extents(t)
            if it is sel:
                cr.set_source_rgb(0.04, 0.52, 1.0)
            else:
                cr.set_source_rgba(1, 1, 1, 0.9 if it["key"] in sizes[it["kind"]] else 0.55)
            cr.move_to(it["x"] + (s * Z - ext.width) / 2, bar_top + BAR * Z + 22)
            cr.show_text(t)
        if sel:
            rx, ry, rw, rh = rect(sel)
            # guides: the selected icon's top and bottom across the whole bar, to line others up with
            cr.set_source_rgba(0.04, 0.52, 1.0, 0.7)
            cr.set_dash([4, 4])
            for y in (round(ry) + 0.5, round(ry + rh) - 0.5):
                cr.move_to(RULER, y)
                cr.line_to(width, y)
                cr.stroke()
            cr.set_dash([])
            # its box and handles
            cr.set_source_rgb(0.04, 0.52, 1.0)
            cr.rectangle(round(rx) + 0.5, round(ry) + 0.5, round(rw) - 1, round(rh) - 1)
            cr.stroke()
            for hx in (rx, rx + rw / 2, rx + rw):
                for hy in (ry, ry + rh / 2, ry + rh):
                    if (hx, hy) != (rx + rw / 2, ry + rh / 2):
                        cr.rectangle(round(hx) - 3, round(hy) - 3, 6, 6)
            cr.fill()
        return False

    # ---- changing a size
    def set_size(it, w, h, keep=None):
        """Set it to w x h (clamped), keeping the proportions if linked; `keep` says which side
        the user moved ("w", "h" or None for whichever changed more)."""
        nw, nh = it["nat"]
        if link.get_active():
            ratio = nh / nw
            if keep is None:
                cw, ch = size_of(it)
                keep = "w" if abs(w - cw) / max(cw, 1) >= abs(h - ch) / max(ch, 1) else "h"
            if keep == "w":
                h = w * ratio
            else:
                w = h / ratio
        w, h = (int(min(s, max(MIN, round(v)))) for v in (w, h))
        sizes[it["kind"]][it["key"]] = [w, h]
        changed()

    def changed():
        area.queue_draw()
        sync_inspector()
        if not pending:
            pending.append(GLib.timeout_add(150, run_apply))

    def run_apply():
        pending.clear()
        apply(sizes)
        update_buttons()
        return False

    # ---- mouse: click an icon to pick it, drag its edges or corners to resize it
    def edges_at(it, px, py):
        rx, ry, rw, rh = rect(it)
        if not (rx - HANDLE <= px <= rx + rw + HANDLE and ry - HANDLE <= py <= ry + rh + HANDLE):
            return ""
        e = ""
        e += "l" if abs(px - rx) <= HANDLE else "r" if abs(px - (rx + rw)) <= HANDLE else ""
        e += "t" if abs(py - ry) <= HANDLE else "b" if abs(py - (ry + rh)) <= HANDLE else ""
        return e

    def on_press(_a, ev):
        area.grab_focus()
        if not items:
            return True
        sel = items[state["sel"]]
        e = edges_at(sel, ev.x, ev.y)
        if e:
            state["drag"] = (e, ev.x, ev.y, size_of(sel))
            return True
        for i, it in enumerate(items):
            if it["x"] <= ev.x <= it["x"] + s * Z and bar_top <= ev.y <= bar_top + BAR * Z + 30:
                state["sel"] = i
                area.queue_draw()
                sync_inspector()
                break
        return True

    def on_motion(_a, ev):
        drag = state["drag"]
        sel = items[state["sel"]] if items else None
        if not drag:
            e = edges_at(sel, ev.x, ev.y) if sel else ""
            name = {"l": "ew-resize", "r": "ew-resize", "t": "ns-resize", "b": "ns-resize",
                    "lt": "nwse-resize", "rb": "nwse-resize", "rt": "nesw-resize", "lb": "nesw-resize"}.get(e)
            win.get_window().set_cursor(Gdk.Cursor.new_from_name(win.get_display(), name) if name else None)
            return True
        e, x0, y0, (w0, h0) = drag
        dx, dy = (ev.x - x0) / Z, (ev.y - y0) / Z
        w = w0 + (2 * dx if "r" in e else -2 * dx if "l" in e else 0)   # the icon stays centred,
        h = h0 + (2 * dy if "b" in e else -2 * dy if "t" in e else 0)   # so both sides move
        keep = "w" if e in ("l", "r") else "h" if e in ("t", "b") else None
        set_size(sel, w, h, keep)
        return True

    def on_release(_a, _ev):
        state["drag"] = None
        return True

    # ---- keys: ←/→ pick, ↑/↓ height, Shift+↑/↓ width (the other follows when linked)
    def on_key(_w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            win.close()
            return True
        if not items or isinstance(win.get_focus(), Gtk.SpinButton):
            return False
        if ev.keyval in (Gdk.KEY_Left, Gdk.KEY_Right):
            state["sel"] = (state["sel"] + (1 if ev.keyval == Gdk.KEY_Right else -1)) % len(items)
            area.queue_draw()
            sync_inspector()
            return True
        if ev.keyval in (Gdk.KEY_Up, Gdk.KEY_Down):
            it, step = items[state["sel"]], 1 if ev.keyval == Gdk.KEY_Up else -1
            w, h = size_of(it)
            if ev.state & Gdk.ModifierType.SHIFT_MASK:
                set_size(it, round(w) + step, h, "w")
            else:
                set_size(it, w, round(h) + step, "h")
            return True
        return False

    # ---- layout
    win = Gtk.Window(title="Bar icon sizes")
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_type_hint(Gdk.WindowTypeHint.DIALOG)   # i3 floats dialogs (files/i3/config)
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=16)
    win.add(outer)
    hint = Gtk.Label(xalign=0, wrap=True)
    hint.set_markup(f"<small>The bar at {Z}×, each icon in its {s}px slot; the ruler counts bar pixels. "
                    "Click an icon, then drag its edges or corners, or use ↑/↓ (height) and "
                    "Shift+↑/↓ (width); ←/→ pick the next one. The real bar follows as you go.</small>")
    outer.pack_start(hint, False, False, 0)

    area = Gtk.DrawingArea(can_focus=True)
    area.set_size_request(width, height)
    area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                    | Gdk.EventMask.POINTER_MOTION_MASK)
    area.connect("draw", draw)
    area.connect("button-press-event", on_press)
    area.connect("motion-notify-event", on_motion)
    area.connect("button-release-event", on_release)
    scroll = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER)
    scroll.set_min_content_width(min(width, 1500))
    scroll.set_min_content_height(height)
    scroll.add(area)
    outer.pack_start(scroll, False, False, 0)

    inspector = Gtk.Box(spacing=8)
    name = Gtk.Label(xalign=0)
    ws = Gtk.SpinButton.new_with_range(MIN, s, 1)
    hs = Gtk.SpinButton.new_with_range(MIN, s, 1)
    link = Gtk.CheckButton(label="Keep proportions", active=True)
    reset = Gtk.Button(label="Reset", tooltip_text="Back to the artwork's own size")
    revert_b = Gtk.Button(label="Revert")
    save_b = Gtk.Button(label="Save")
    save_b.get_style_context().add_class("suggested-action")
    for widget in (name, Gtk.Label(label="  W"), ws, Gtk.Label(label="H"), hs, link, reset):
        inspector.pack_start(widget, False, False, 0)
    inspector.pack_end(save_b, False, False, 0)
    inspector.pack_end(revert_b, False, False, 0)
    outer.pack_start(inspector, False, False, 0)
    status = Gtk.Label(xalign=0)
    outer.pack_start(status, False, False, 0)

    busy = []

    def sync_inspector():
        if not items:
            return
        it = items[state["sel"]]
        w, h = size_of(it)
        name.set_markup(f"<b>{GLib.markup_escape_text(it['label'])}</b>")
        busy.append(1)
        ws.set_value(round(w))
        hs.set_value(round(h))
        busy.clear()

    def on_spin(spin):
        if busy or not items:
            return
        it = items[state["sel"]]
        set_size(it, ws.get_value(), hs.get_value(), "w" if spin is ws else "h")

    def on_reset(_b):
        if items:
            it = items[state["sel"]]
            sizes[it["kind"]].pop(it["key"], None)
            changed()

    def dirty():
        return sizes != saved

    def update_buttons():
        save_b.set_sensitive(dirty())
        revert_b.set_sensitive(dirty())

    def do_save(_b):
        save_sizes(sizes)
        saved.clear()
        saved.update(json.loads(json.dumps(sizes)))
        status.set_markup(f"<small>Saved to {GLib.markup_escape_text(os.path.relpath(CONFIG, os.path.expanduser('~')))}"
                          " (commit it to keep it in git)</small>")
        update_buttons()

    def do_revert(_b):
        for k in ("pinned", "tray"):
            sizes[k] = dict(saved[k])
        status.set_text("")
        changed()

    def on_close(_w, _e):
        if not dirty():
            return False
        dlg = Gtk.MessageDialog(transient_for=win, modal=True, message_type=Gtk.MessageType.QUESTION,
                                text="Save the new icon sizes?")
        dlg.format_secondary_text("If you don't, the bar goes back to the saved sizes.")
        dlg.add_buttons("Don't Save", Gtk.ResponseType.NO, "Cancel", Gtk.ResponseType.CANCEL,
                        "Save", Gtk.ResponseType.YES)
        answer = dlg.run()
        dlg.destroy()
        if answer in (Gtk.ResponseType.CANCEL, Gtk.ResponseType.DELETE_EVENT):
            return True
        if answer == Gtk.ResponseType.YES:
            do_save(None)
        else:
            apply(saved)
        return False

    ws.connect("value-changed", on_spin)
    hs.connect("value-changed", on_spin)
    reset.connect("clicked", on_reset)
    save_b.connect("clicked", do_save)
    revert_b.connect("clicked", do_revert)
    win.connect("delete-event", on_close)
    win.connect("destroy", Gtk.main_quit)
    win.connect("key-press-event", on_key)
    sync_inspector()
    update_buttons()
    win.show_all()
    area.grab_focus()
    Gtk.main()


def main():
    if sys.argv[1:] == ["apply"]:
        apply(load_sizes())
        return 0
    if sys.argv[1:]:
        print(__doc__.strip())
        return 2
    window()
    return 0


if __name__ == "__main__":
    sys.exit(main())
