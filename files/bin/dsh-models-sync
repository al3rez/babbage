#!@python@
"""Keep DeepSeek Harness's Alibaba Cloud Model Studio model list current.

Reads the Token Plan Personal Edition model list from Alibaba's own DeepSeek Harness guide
(DOCS below) and rewrites the `models:` list of the bailian-tpp provider in
~/.dsh/profiles/web/cordis.patch.yml to match:
every chat model, newest first within each family (DeepSeek, auto, Qwen, GLM, then anything
else). Audio, image and video models are left out: the harness only chats. A model's own
settings (the indented lines under its `- id:`, e.g. qwen4-max's maxTokens) are kept. Nothing
else in the file is touched (the Web UI edits it too). When the list changed, dsh-web is restarted so the
model picker shows it, unless a session was written in the last 10 minutes (a run in progress
would be cut off); then the list takes effect at its next start. Runs from the dsh-models-sync
user timer: daily, and shortly after login.

Never calls the Token Plan API: the plan's terms allow the key only for interactive use inside
coding/agent tools and may ban it for automated or scripted calls, so a timer must not use it.
"""
import html
import os
import re
import subprocess
import sys
import time
import urllib.request

DOCS = "https://www.alibabacloud.com/help/en/model-studio/deepseek-harness"

PATCH = os.path.expanduser("~/.dsh/profiles/web/cordis.patch.yml")
SESSIONS = os.path.expanduser("~/.dsh/sessions")
NOT_CHAT = re.compile(r"audio|image|video|tts|asr|realtime|embed|rerank|^wan", re.I)
FAMILIES = ("deepseek", "auto", "qwen", "glm")
QUIET_FOR = 600   # seconds since the last session write before restarting dsh-web


def log(msg):
    print(msg, flush=True)


ITEM = re.compile(r"([ \t]+)- id: (\S+)\n((?:\1[ \t]+\S.*\n)*)")   # a model, then its deeper lines


def provider_block(text):
    """(start, end, indent, {id: its settings lines}) of the bailian-tpp models list items."""
    m = re.search(r"^\s*bailian-tpp:\n", text, re.M)
    if not m:
        sys.exit("no bailian-tpp provider in " + PATCH)
    models = re.compile(r"^\s*models:\n", re.M).search(text, m.end())
    start = end = models.end()
    settings = {}
    while (it := ITEM.match(text, end)):
        settings[it.group(2)] = it.group(3)
        end = it.end()
    indent = re.match(r"[ \t]*", text[start:end]).group(0)
    return start, end, indent, settings


def docs_models():
    """Model ids in the guide's Token Plan Personal Edition config example."""
    req = urllib.request.Request(DOCS, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=30) as r:
        page = r.read().decode("utf-8", "replace")
    page = re.sub(r"<script.*?</script>|<style.*?</style>", "", page, flags=re.S)
    text = html.unescape(re.sub(r"<[^>]+>", "", page))
    m = re.search(r"Token Plan Personal Edition\s*- id: llm-pi-ai(.*?)(?:Token Plan Team Edition|$)", text, re.S)
    if not m:
        sys.exit("the guide's Personal Edition example wasn't found; leaving the list alone")
    block = m.group(1)
    return re.findall(r"- id:\s*([A-Za-z0-9._-]+)", block[block.find("models:"):])


def order(ids):
    def key(i):
        fam = next((n for n, f in enumerate(FAMILIES) if i.startswith(f)), len(FAMILIES))
        name = re.sub(r"-\d{4}$", "", i)            # dated snapshot -> its model
        nums = [int(n) for n in re.findall(r"\d+", name)][:4]
        newest_first = [-n for n in nums + [0] * (4 - len(nums))]   # v4.1 before v4
        # each model, then its dated snapshots (deepseek-v4-pro, deepseek-v4-pro-0813)
        return (fam, newest_first, name, i)
    return sorted(ids, key=key)


def dsh_recently_used():
    newest = 0.0
    for root, _, files in os.walk(SESSIONS):
        for f in files:
            try:
                newest = max(newest, os.path.getmtime(os.path.join(root, f)))
            except OSError:
                pass
    return time.time() - newest < QUIET_FOR


def main():
    text = open(PATCH).read()
    start, end, indent, settings = provider_block(text)
    ids = order(i for i in docs_models() if not NOT_CHAT.search(i))
    if len(ids) < 3:
        sys.exit(f"the guide listed only {ids}; leaving the list alone")
    old = list(settings)
    if ids == old:
        log(f"up to date: {len(ids)} models")
        return
    added, gone = [i for i in ids if i not in old], [i for i in old if i not in ids]
    tmp = PATCH + ".tmp"
    with open(tmp, "w") as f:
        f.write(text[:start] + "".join(f"{indent}- id: {i}\n{settings.get(i, '')}" for i in ids) + text[end:])
    os.chmod(tmp, 0o600)
    os.replace(tmp, PATCH)
    log(f"models updated: added {added}, removed {gone}")
    if subprocess.run(["systemctl", "--user", "is-active", "-q", "dsh-web"]).returncode != 0:
        return
    if dsh_recently_used():
        log("DeepSeek Harness is in use; the new list applies at its next start")
    else:
        subprocess.run(["systemctl", "--user", "restart", "dsh-web"])
        log("restarted dsh-web")


if __name__ == "__main__":
    main()
